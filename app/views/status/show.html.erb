<% content_for :title, "#{@inspection_request.reference_code} status — Hey Tec Inspect" %>

<div class="space-y-8">
  <div>
    <p class="section-label mb-2">Inspection status</p>
    <div class="job-detail-heading">
      <% if @inspection_request.scheduled_on.present? %>
        <div class="job-cal" aria-label="<%= @inspection_request.scheduled_on.strftime("%-d %B") %><%= " #{@inspection_request.scheduled_period}" if @inspection_request.scheduled_period.present? %>">
          <div class="job-cal__badge">
            <span class="job-cal__month"><%= @inspection_request.scheduled_on.strftime("%b") %></span>
            <span class="job-cal__day"><%= @inspection_request.scheduled_on.strftime("%-d") %></span>
            <% if @inspection_request.scheduled_period.present? %>
              <span class="job-cal__period job-cal__period--<%= @inspection_request.scheduled_period.downcase %>">
                <%= @inspection_request.scheduled_period %>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>
      <div class="job-detail-heading__body min-w-0">
        <h1 class="page-title"><%= @inspection_request.site_name %></h1>
        <p class="page-lede">
          <%= @inspection_request.company_name %> · <%= @inspection_request.reference_code %>
        </p>
        <div class="mt-2"><%= status_badge(@inspection_request.status) %></div>
      </div>
    </div>
  </div>

  <section class="card">
    <div class="card-section">
      <h2 class="section-label mb-4">Inspection details</h2>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="min-w-0">
          <dt class="text-sm text-ink-muted">Site</dt>
          <dd class="text-base font-medium mt-0.5 break-words"><%= @inspection_request.site_name %></dd>
        </div>
        <div class="min-w-0">
          <dt class="text-sm text-ink-muted">Company</dt>
          <dd class="text-base font-medium mt-0.5 break-words"><%= @inspection_request.company_name %></dd>
        </div>
        <div class="min-w-0">
          <dt class="text-sm text-ink-muted">Requestor</dt>
          <dd class="mt-0.5 requestor-identity">
            <span class="requestor-identity__avatar" aria-hidden="true">
              <span class="requestor-identity__initials"><%= initials_for(@inspection_request.requestor_name) %></span>
            </span>
            <span class="requestor-identity__body">
              <span class="block text-base font-medium break-words"><%= @inspection_request.requestor_name %></span>
              <% if (wa_href = whatsapp_href(@inspection_request.whatsapp_number)) %>
                <a class="requestor-identity__phone break-words inline-flex items-center gap-1 no-underline"
                   href="<%= wa_href %>"
                   target="_blank"
                   rel="noopener noreferrer"
                   title="Message <%= @inspection_request.requestor_name %> on WhatsApp">
                  <%= @inspection_request.full_contact_number %>
                  <%= whatsapp_icon %>
                </a>
              <% else %>
                <span class="block requestor-identity__phone break-words"><%= @inspection_request.full_contact_number %></span>
              <% end %>
            </span>
          </dd>
        </div>
        <div class="min-w-0">
          <dt class="text-sm text-ink-muted">Point of contact</dt>
          <% if @inspection_request.point_of_contact? %>
            <dd class="mt-0.5 requestor-identity">
              <span class="requestor-identity__avatar" aria-hidden="true">
                <span class="requestor-identity__initials"><%= initials_for(@inspection_request.poc_name) %></span>
              </span>
              <span class="requestor-identity__body">
                <span class="block text-base font-medium break-words"><%= @inspection_request.poc_name %></span>
                <% if (poc_wa_href = whatsapp_href(@inspection_request.poc_whatsapp_number)) %>
                  <a class="requestor-identity__phone break-words inline-flex items-center gap-1 no-underline"
                     href="<%= poc_wa_href %>"
                     target="_blank"
                     rel="noopener noreferrer"
                     title="Message <%= @inspection_request.poc_name %> on WhatsApp">
                    <%= @inspection_request.full_poc_contact_number %>
                    <%= whatsapp_icon %>
                  </a>
                <% else %>
                  <span class="block requestor-identity__phone break-words"><%= @inspection_request.full_poc_contact_number %></span>
                <% end %>
              </span>
            </dd>
          <% else %>
            <dd class="text-base mt-0.5 break-words value-dash">—</dd>
          <% end %>
        </div>
        <div class="min-w-0 sm:col-span-2">
          <dt class="text-sm text-ink-muted">Inspector (FSP)</dt>
          <% if @inspection_request.fsp.present? %>
            <dd class="mt-0.5 requestor-identity">
              <span class="requestor-identity__avatar" aria-hidden="true">
                <span class="requestor-identity__initials"><%= initials_for(@inspection_request.fsp.full_name) %></span>
              </span>
              <span class="requestor-identity__body">
                <span class="block text-base font-medium break-words"><%= @inspection_request.fsp.full_name %></span>
                <% if (fsp_wa_href = whatsapp_href(@inspection_request.fsp.whatsapp_number)) %>
                  <a class="requestor-identity__phone break-words inline-flex items-center gap-1 no-underline"
                     href="<%= fsp_wa_href %>"
                     target="_blank"
                     rel="noopener noreferrer"
                     title="Message <%= @inspection_request.fsp.full_name %> on WhatsApp">
                    <%= @inspection_request.fsp.full_contact_number %>
                    <%= whatsapp_icon %>
                  </a>
                <% else %>
                  <span class="block requestor-identity__phone break-words"><%= @inspection_request.fsp.full_contact_number %></span>
                <% end %>
              </span>
            </dd>
          <% else %>
            <dd class="text-base font-medium mt-0.5 break-words"><%= @inspection_request.inspector_label.presence || content_tag(:span, "—", class: "value-dash") %></dd>
          <% end %>
        </div>
        <div class="min-w-0">
          <dt class="text-sm text-ink-muted">Google Maps</dt>
          <dd class="text-base font-medium mt-0.5 break-words">
            <% if (map_href = @inspection_request.safe_map_url) %>
              <%= content_tag :a, "Open in Google Maps",
                          href: map_href,
                          class: "no-underline break-all",
                          target: "_blank",
                          rel: "noopener noreferrer" %>
              <span class="text-ink-muted font-normal"
                    data-controller="clipboard"
                    data-clipboard-text-value="<%= map_href %>">
                (<button type="button"
                        class="bg-transparent border-0 p-0 cursor-pointer font-medium text-accent underline-offset-2 hover:underline"
                        data-action="clipboard#copy"
                        data-clipboard-target="label"
                        aria-label="Copy Google Maps link">Copy</button>)
              </span>
            <% else %>
              <span class="value-dash">—</span>
            <% end %>
          </dd>
        </div>
        <div class="min-w-0">
          <dt class="text-sm text-ink-muted">Site note</dt>
          <dd class="text-base font-medium mt-0.5 text-ink whitespace-pre-wrap break-words"><%= @inspection_request.site_note.to_s.strip.presence || content_tag(:span, "—", class: "value-dash") %></dd>
        </div>
      </dl>
    </div>
  </section>

  <%= render "shared/cranes_table",
             cranes: @inspection_request.cranes,
             title: "Cranes on this job" %>

  <section class="card">
    <div class="card-section">
      <h2 class="section-label mb-5">Timeline</h2>
      <ol class="relative space-y-0">
        <% @inspection_request.status_timeline.each_with_index do |event, index| %>
          <li class="flex gap-4 pb-1 last:pb-0">
            <div class="flex flex-col items-center">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border-2 text-xs font-semibold
                <%= if event[:failed]
                      'border-red-300 bg-red-100 text-red-700'
                    elsif event[:done]
                      'border-green-600 bg-green-600 text-white'
                    else
                      'border-[--color-line-strong] bg-white text-[--color-ink-faint]'
                    end %>">
                <%= timeline_marker_content(event, index) %>
              </span>
              <% unless index == @inspection_request.status_timeline.length - 1 %>
                <span class="w-px flex-1 mt-1 <%= event[:failed] ? 'bg-red-200' : (event[:done] ? 'bg-green-300' : 'bg-[--color-line]') %>"></span>
              <% end %>
            </div>
            <div class="pt-1 min-w-0 pb-3">
              <p class="font-medium <%= if event[:failed]
                                          'text-red-700'
                                        elsif event[:done]
                                          'text-[--color-ink]'
                                        else
                                          'text-[--color-ink-faint]'
                                        end %>">
                <%= event[:label] %>
              </p>
              <% if event[:at].present? %>
                <p class="text-sm text-[--color-ink-muted] mt-0.5"><%= format_datetime(event[:at]) %></p>
              <% elsif !event[:done] %>
                <p class="text-sm text-[--color-ink-faint] mt-0.5">Waiting…</p>
              <% end %>
              <% if event[:detail].present? %>
                <p class="text-sm text-[--color-ink-muted] mt-1"><%= event[:detail] %></p>
              <% end %>
            </div>
          </li>
        <% end %>
      </ol>
    </div>
  </section>
</div>
