<% content_for :title, "Jobs — Hey Tec Inspect" %>

<div class="space-y-8">
  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
    <div>
      <h1 class="page-title">Inspection jobs</h1>
      <p class="page-lede">Review requests, accept work, schedule inspectors, mark complete.</p>
    </div>
  </div>

  <div class="job-list-toolbar">
    <%= form_with url: dashboard_inspection_requests_path, method: :get, class: "job-list-search" do %>
      <% if @status_filter %>
        <%= hidden_field_tag :status, @status_filter %>
      <% end %>
      <% if @sort == "asc" %>
        <%= hidden_field_tag :sort, "asc" %>
      <% end %>
      <label class="sr-only" for="job-search">Search jobs</label>
      <svg class="job-list-search__icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8" />
        <path d="m21 21-4.3-4.3" />
      </svg>
      <input type="search"
             name="q"
             id="job-search"
             value="<%= @query %>"
             placeholder="Search site, company, job number, or FSP"
             class="field-input job-list-search__input"
             autocomplete="off">
    <% end %>

    <% if @query.present? %>
      <%= link_to "Clear search",
                  dashboard_inspection_requests_path(status: @status_filter, sort: (@sort == "asc" ? "asc" : nil)),
                  class: "job-list-search__clear text-sm" %>
    <% end %>

    <div class="job-list-actions">
      <div class="job-list-filter"
           data-controller="dropdown"
           data-dropdown-open-class="is-open"
           data-action="click@window->dropdown#hide keydown@window->dropdown#keydown">
        <button type="button"
                class="job-list-filter__button<%= " is-active" if @status_filter %>"
                data-dropdown-target="button"
                data-action="dropdown#toggle"
                aria-haspopup="menu"
                aria-expanded="false"
                aria-label="Filter by status">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
          </svg>
        </button>
        <div class="job-list-filter__menu" data-dropdown-target="menu" role="menu" hidden>
          <% filter_options = [[ "All", nil ]] + InspectionRequest::STATUSES.map { |status| [ status_label(status), status ] } %>
          <% filter_options.each do |label, status| %>
            <% selected = @status_filter == status %>
            <%= link_to dashboard_inspection_requests_path(status: status, q: @query, sort: (@sort == "asc" ? "asc" : nil)),
                        class: "job-list-filter__option no-underline",
                        role: "menuitemradio",
                        aria: { checked: selected } do %>
              <span class="job-list-filter__mark" aria-hidden="true">
                <% if selected %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                <% end %>
              </span>
              <span><%= label %></span>
              <span class="job-list-filter__count"><%= status.nil? ? @all_count : (@status_counts[status] || 0) %></span>
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="job-list-filter"
           data-controller="dropdown"
           data-dropdown-open-class="is-open"
           data-action="click@window->dropdown#hide keydown@window->dropdown#keydown">
        <button type="button"
                class="job-list-filter__button<%= " is-active" if @sort == "asc" %>"
                data-dropdown-target="button"
                data-action="dropdown#toggle"
                aria-haspopup="menu"
                aria-expanded="false"
                aria-label="Sort by reference number">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m3 8 4-4 4 4" />
            <path d="M7 4v16" />
            <path d="m21 16-4 4-4-4" />
            <path d="M17 20V4" />
          </svg>
        </button>
        <div class="job-list-filter__menu" data-dropdown-target="menu" role="menu" hidden>
          <% [["Ref no ascending", "asc"], ["Ref no descending", "desc"]].each do |label, value| %>
            <% selected = @sort == value %>
            <%= link_to dashboard_inspection_requests_path(status: @status_filter, q: @query, sort: (value == "desc" ? nil : value)),
                        class: "job-list-filter__option no-underline",
                        role: "menuitemradio",
                        aria: { checked: selected } do %>
              <span class="job-list-filter__mark" aria-hidden="true">
                <% if selected %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                <% end %>
              </span>
              <span><%= label %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <% if @inspection_requests.any? %>
    <div class="space-y-2">
      <%= render "shared/job_docs_legend" %>
      <div class="card overflow-hidden">
        <ul class="divide-y divide-line-soft">
          <% @inspection_requests.each do |request| %>
            <%= render "shared/job_list_item",
                       request: request,
                       url: dashboard_inspection_request_path(request) %>
          <% end %>
        </ul>
      </div>
    </div>
  <% else %>
    <div class="text-center py-12 text-[--color-ink-muted]">
      <p class="font-medium text-[--color-ink]">No jobs here yet</p>
      <p class="text-sm mt-1">
        <% if @query.present? && @status_filter %>
          No <%= status_label(@status_filter).downcase %> jobs match “<%= @query %>”.
          <%= link_to "Clear search", dashboard_inspection_requests_path(status: @status_filter, sort: (@sort == "asc" ? "asc" : nil)) %>
        <% elsif @query.present? %>
          No jobs match “<%= @query %>”.
          <%= link_to "Clear search", dashboard_inspection_requests_path(sort: (@sort == "asc" ? "asc" : nil)) %>
        <% elsif @status_filter %>
          Nothing in <strong><%= status_label(@status_filter) %></strong>.
          <%= link_to "View all", dashboard_inspection_requests_path(sort: (@sort == "asc" ? "asc" : nil)) %>
        <% else %>
          Public requests will show up here when submitted.
        <% end %>
      </p>
    </div>
  <% end %>
</div>
