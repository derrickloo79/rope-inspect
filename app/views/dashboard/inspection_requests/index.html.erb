<% content_for :title, "Jobs — RopeInspect" %>

<div class="space-y-8">
  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
    <div>
      <h1 class="page-title">Inspection jobs</h1>
      <p class="page-lede">Review requests, accept work, schedule inspectors, mark complete.</p>
    </div>
  </div>

  <%# Status filter pills %>
  <div class="job-filter-pills" role="tablist" aria-label="Filter jobs by status">
    <%= link_to dashboard_inspection_requests_path,
                class: "job-filter-pill no-underline #{@status_filter.nil? ? "is-active" : ""}",
                role: "tab",
                "aria-selected": @status_filter.nil? do %>
      All
      <span class="job-filter-pill__count"><%= @counts.values.sum %></span>
    <% end %>
    <% InspectionRequest::STATUSES.each do |status| %>
      <%= link_to dashboard_inspection_requests_path(status: status),
                  class: "job-filter-pill no-underline #{@status_filter == status ? "is-active" : ""}",
                  role: "tab",
                  "aria-selected": @status_filter == status do %>
        <%= status.humanize %>
        <span class="job-filter-pill__count"><%= @counts[status] || 0 %></span>
      <% end %>
    <% end %>
  </div>

  <% if @inspection_requests.any? %>
    <div class="card overflow-hidden">
      <ul class="divide-y divide-[--color-line]">
        <% @inspection_requests.each do |request| %>
          <li>
            <%= link_to dashboard_inspection_request_path(request), class: "no-underline block px-5 py-4 hover:bg-stone-50 transition-colors" do %>
              <div class="flex flex-row items-start sm:items-center justify-between gap-3">
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-medium text-[--color-ink]"><%= request.company_name %></span>
                    <%= status_badge(request.status) %>
                  </div>
                  <p class="text-sm text-[--color-ink-muted] mt-0.5 truncate">
                    <%= request.site_name %> · <%= pluralize(request.cranes.size, "crane") %> · <%= request.reference_code %>
                  </p>
                </div>
                <div class="text-sm text-[--color-ink-faint] shrink-0 whitespace-nowrap pt-0.5 sm:pt-0">
                  <%= format_list_timestamp(request.created_at) %>
                </div>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% else %>
    <div class="card">
      <div class="card-section text-center py-12 text-[--color-ink-muted]">
        <p class="font-medium text-[--color-ink]">No jobs here yet</p>
        <p class="text-sm mt-1">
          <% if @status_filter %>
            Nothing in <strong><%= @status_filter %></strong>.
            <%= link_to "View all", dashboard_inspection_requests_path %>
          <% else %>
            Public requests will show up here when submitted.
          <% end %>
        </p>
      </div>
    </div>
  <% end %>
</div>
