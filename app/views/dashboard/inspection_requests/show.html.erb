<% content_for :title, "#{@inspection_request.reference_code} — Hey Tec Inspect" %>

<% sticky_actions = @inspection_request.pending? || @inspection_request.accepted? || @inspection_request.scheduled? %>
<% schedule_actions = @inspection_request.accepted? || @inspection_request.scheduled? %>
<% accepted_collapsible = @inspection_request.accepted? %>
<% show_actions_card = @inspection_request.pending? || @inspection_request.rejected? || @inspection_request.scheduled? || @inspection_request.completed? %>

<div class="job-detail-page<%= " job-detail-page--sticky-actions" if sticky_actions %><%= " job-detail-page--accepted-dock" if accepted_collapsible %>">
  <div class="job-detail-intro">
    <%= link_to "← All jobs", dashboard_inspection_requests_path, class: "text-sm no-underline text-ink-muted hover:text-ink" %>
    <div class="mt-3 job-detail-heading">
      <% if @inspection_request.scheduled_on.present? %>
        <div class="job-cal" aria-label="<%= @inspection_request.scheduled_on.strftime("%-d %B") %><%= " #{@inspection_request.scheduled_period}" if @inspection_request.scheduled_period.present? %>">
          <div class="job-cal__badge">
            <span class="job-cal__month"><%= @inspection_request.scheduled_on.strftime("%b") %></span>
            <span class="job-cal__day"><%= @inspection_request.scheduled_on.strftime("%-d") %></span>
            <% if @inspection_request.scheduled_period.present? %>
              <span class="job-cal__period job-cal__period--<%= @inspection_request.scheduled_period.downcase %>">
                <%= @inspection_request.scheduled_period %>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>
      <div class="job-detail-heading__body min-w-0">
        <h1 class="page-title"><%= @inspection_request.site_name %></h1>
        <p class="page-lede"><%= @inspection_request.company_name %> · <%= @inspection_request.reference_code %></p>
        <div class="mt-2"><%= status_badge(@inspection_request.status) %></div>
      </div>
      <div class="job-detail-menu shrink-0"
           data-controller="dropdown"
           data-dropdown-open-class="is-open"
           data-action="click@window->dropdown#hide keydown@window->dropdown#keydown">
        <button type="button"
                class="job-detail-menu__button"
                data-dropdown-target="button"
                data-action="dropdown#toggle"
                aria-haspopup="menu"
                aria-expanded="false"
                aria-label="Job actions">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <circle cx="12" cy="5" r="2" />
            <circle cx="12" cy="12" r="2" />
            <circle cx="12" cy="19" r="2" />
          </svg>
        </button>

        <div class="job-detail-menu__panel" data-dropdown-target="menu" role="menu" hidden>
          <%= link_to edit_dashboard_inspection_request_path(@inspection_request),
                      class: "job-detail-menu__item",
                      role: "menuitem" do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
              <path d="m15 5 4 4" />
            </svg>
            <span>Edit</span>
          <% end %>

          <% if (send_href = whatsapp_href(@inspection_request.whatsapp_number, text: job_details_whatsapp_message(@inspection_request))) %>
            <%= link_to send_href,
                        class: "job-detail-menu__item",
                        target: "_blank",
                        rel: "noopener noreferrer",
                        role: "menuitem" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m22 2-7 20-4-9-9-4Z" />
                <path d="M22 2 11 13" />
              </svg>
              <span>Whatsapp job updates</span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="job-detail-main space-y-6">
    <section class="card">
      <div class="card-section">
        <h2 class="section-label mb-4">Requestor</h2>
        <dl class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="min-w-0">
            <dt class="text-sm text-[--color-ink-muted]">Name</dt>
            <dd class="text-base font-medium mt-0.5 break-words"><%= @inspection_request.requestor_name %></dd>
          </div>
          <div class="min-w-0">
            <dt class="text-sm text-[--color-ink-muted]">Phone</dt>
            <dd class="text-base font-medium mt-0.5 break-words">
              <% if (wa_href = whatsapp_href(@inspection_request.whatsapp_number)) %>
                <a class="inline-flex items-center gap-1 no-underline"
                   href="<%= wa_href %>"
                   target="_blank"
                   rel="noopener noreferrer"
                   title="Message <%= @inspection_request.requestor_name %> on WhatsApp">
                  <%= @inspection_request.full_contact_number %>
                  <%= whatsapp_icon %>
                </a>
              <% else %>
                <%= @inspection_request.full_contact_number %>
              <% end %>
            </dd>
          </div>
          <div class="min-w-0">
            <dt class="text-sm text-[--color-ink-muted]">Submitted</dt>
            <dd class="text-base font-medium mt-0.5 break-words"><%= format_datetime(@inspection_request.created_at) %></dd>
          </div>
        </dl>
      </div>
    </section>

    <% unless @inspection_request.pending? %>
      <% poc_field_errors = @inspection_request.errors[:poc_name].any? || @inspection_request.errors[:poc_contact_number].any? || @inspection_request.errors[:poc_country_code].any? %>
      <% poc_editing = poc_field_errors || !@inspection_request.point_of_contact? %>
      <section class="card"
               id="point-of-contact"
               data-controller="site-access"
               data-site-access-editing-value="<%= poc_editing %>">
        <div class="card-section flex flex-col gap-4">
          <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
            <div>
              <h2 class="section-label">Point of contact (POC)</h2>
              <p class="text-sm text-ink-muted mt-1">
                On-site contact person for the inspection day.
              </p>
            </div>
            <button type="button"
                    class="btn-secondary shrink-0 self-start cursor-pointer"
                    data-action="site-access#edit"
                    data-site-access-target="view">
              <%= @inspection_request.point_of_contact? ? "Edit" : "Add details" %>
            </button>
          </div>

          <% if poc_field_errors %>
            <div class="error-list" role="alert">
              <ul class="list-disc list-inside">
                <% @inspection_request.errors.full_messages_for(:poc_name).each do |message| %>
                  <li><%= message %></li>
                <% end %>
                <% @inspection_request.errors.full_messages_for(:poc_contact_number).each do |message| %>
                  <li><%= message %></li>
                <% end %>
                <% @inspection_request.errors.full_messages_for(:poc_country_code).each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <%# View mode %>
          <div data-site-access-target="view" class="space-y-3">
            <% if @inspection_request.point_of_contact? %>
              <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="min-w-0">
                  <dt class="text-sm text-ink-muted">Name</dt>
                  <dd class="text-base font-medium mt-0.5 break-words"><%= @inspection_request.poc_name %></dd>
                </div>
                <div class="min-w-0">
                  <dt class="text-sm text-ink-muted">Contact number</dt>
                  <dd class="text-base font-medium mt-0.5 break-words">
                    <% if (poc_wa_href = whatsapp_href(@inspection_request.poc_whatsapp_number)) %>
                      <a class="inline-flex items-center gap-1 no-underline"
                         href="<%= poc_wa_href %>"
                         target="_blank"
                         rel="noopener noreferrer"
                         title="Message <%= @inspection_request.poc_name %> on WhatsApp">
                        <%= @inspection_request.full_poc_contact_number %>
                        <%= whatsapp_icon %>
                      </a>
                    <% else %>
                      <%= @inspection_request.full_poc_contact_number %>
                    <% end %>
                  </dd>
                </div>
              </dl>
            <% else %>
              <p class="text-sm text-ink-muted">
                No point of contact yet.
                <button type="button" class="font-medium text-accent bg-transparent border-0 p-0 cursor-pointer underline-offset-2 hover:underline" data-action="site-access#edit">
                  Add details
                </button>
              </p>
            <% end %>
          </div>

          <%# Edit mode %>
          <div data-site-access-target="form" hidden>
            <%= form_with model: @inspection_request,
                          url: point_of_contact_dashboard_inspection_request_path(@inspection_request),
                          method: :patch,
                          class: "space-y-4" do |f| %>
              <div>
                <%= f.label :poc_name, "Name", class: "field-label" %>
                <%= f.text_field :poc_name,
                                class: "field-input",
                                placeholder: "e.g. Site supervisor name",
                                autocomplete: "name" %>
              </div>
              <div>
                <%= f.label :poc_contact_number, "Contact number", class: "field-label" %>
                <div class="grid grid-cols-4 gap-2" data-controller="country-code-select">
                  <div class="col-span-1 min-w-0">
                    <%= f.select :poc_country_code,
                                 country_code_select_options(@inspection_request.poc_country_code.presence || InspectionRequest::DEFAULT_COUNTRY_CODE),
                                 {},
                                 country_code_select_html_options %>
                  </div>
                  <div class="col-span-3 min-w-0">
                    <%= f.telephone_field :poc_contact_number,
                                          class: "field-input",
                                          placeholder: "e.g. 91234567",
                                          autocomplete: "tel-national",
                                          inputmode: "numeric",
                                          pattern: "[0-9]*",
                                          title: "Digits only",
                                          data: {
                                            controller: "digits-only",
                                            action: "input->digits-only#filter"
                                          } %>
                  </div>
                </div>
                <p class="field-hint">Country code for WhatsApp. Local number only in the right field.</p>
              </div>
              <div class="flex flex-col sm:flex-row sm:items-center gap-3">
                <%= f.submit "Save POC", class: "btn-primary cursor-pointer" %>
                <button type="button" class="btn-secondary cursor-pointer" data-action="site-access#cancel">
                  Cancel
                </button>
              </div>
            <% end %>
          </div>
        </div>
      </section>
    <% end %>

    <%= render "crane_certificates" %>

    <% unless @inspection_request.pending? %>
      <% site_access_errors = @inspection_request.errors[:map_url].any? || @inspection_request.errors[:site_note].any? %>
      <% site_access_editing = site_access_errors || !@inspection_request.site_access? %>
      <section class="card"
               id="site-access"
               data-controller="site-access"
               data-site-access-editing-value="<%= site_access_editing %>">
        <div class="card-section flex flex-col gap-4">
          <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
            <div>
              <h2 class="section-label">Site access</h2>
              <p class="text-sm text-ink-muted mt-1">
                Approximate map location and notes for the inspector (gate, parking, landmark).
              </p>
            </div>
            <button type="button"
                    class="btn-secondary shrink-0 self-start cursor-pointer"
                    data-action="site-access#edit"
                    data-site-access-target="view">
              <%= @inspection_request.site_access? ? "Edit" : "Add details" %>
            </button>
          </div>

          <% if site_access_errors %>
            <div class="error-list" role="alert">
              <ul class="list-disc list-inside">
                <% (@inspection_request.errors[:map_url] + @inspection_request.errors[:site_note]).each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <%# View mode %>
          <div data-site-access-target="view" class="space-y-3">
            <% if @inspection_request.site_access? %>
              <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="min-w-0">
                  <dt class="text-sm text-ink-muted">Google Maps</dt>
                  <dd class="text-base font-medium mt-0.5 break-words">
                    <% if (map_href = @inspection_request.safe_map_url) %>
                      <%= content_tag :a, "Open in Google Maps",
                                  href: map_href,
                                  class: "no-underline break-all",
                                  target: "_blank",
                                  rel: "noopener noreferrer" %>
                      <span class="text-ink-muted font-normal"
                            data-controller="clipboard"
                            data-clipboard-text-value="<%= map_href %>">
                        (<button type="button"
                                class="bg-transparent border-0 p-0 cursor-pointer font-medium text-accent underline-offset-2 hover:underline"
                                data-action="clipboard#copy"
                                data-clipboard-target="label"
                                aria-label="Copy Google Maps link">Copy</button>)
                      </span>
                    <% else %>
                      <span class="value-dash">—</span>
                    <% end %>
                  </dd>
                </div>
                <div class="min-w-0">
                  <dt class="text-sm text-ink-muted">Site note</dt>
                  <dd class="text-base font-medium mt-0.5 text-ink whitespace-pre-wrap break-words"><%= @inspection_request.site_note.to_s.strip.presence || content_tag(:span, "—", class: "value-dash") %></dd>
                </div>
              </dl>
            <% else %>
              <p class="text-sm text-ink-muted">
                No map link or site note yet.
                <button type="button" class="font-medium text-accent bg-transparent border-0 p-0 cursor-pointer underline-offset-2 hover:underline" data-action="site-access#edit">
                  Add details
                </button>
              </p>
            <% end %>
          </div>

          <%# Edit mode %>
          <div data-site-access-target="form" hidden>
            <%= form_with model: @inspection_request,
                          url: site_access_dashboard_inspection_request_path(@inspection_request),
                          method: :patch,
                          class: "space-y-4" do |f| %>
              <div>
                <%= f.label :map_url, "Map location", class: "field-label" %>
                <div class="field-clearable"
                     data-controller="map-location"
                     data-map-location-api-key-value="<%= google_maps_api_key %>">
                  <%= f.text_field :map_url,
                                  class: "field-input field-input--clearable",
                                  placeholder: "Search address or paste a Google Maps link",
                                  autocomplete: "off",
                                  role: "combobox",
                                  aria: { autocomplete: "list", expanded: "false" },
                                  data: {
                                    map_location_target: "input",
                                    action: "focus->map-location#prepare input->map-location#suggest keydown->map-location#keydown"
                                  } %>
                  <button type="button"
                          class="field-clear-btn"
                          data-map-location-target="clear"
                          data-action="map-location#clear"
                          hidden
                          aria-label="Clear map location">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M18 6L6 18M6 6l12 12" />
                    </svg>
                  </button>
                  <ul class="map-suggest"
                      data-map-location-target="list"
                      role="listbox"
                      hidden></ul>
                </div>
                <p class="field-hint">
                  <% if google_maps_api_key.present? %>
                    Start typing a site address for suggestions, or paste a Google Maps share link.
                  <% else %>
                    Paste a Google Maps share link (or set GOOGLE_MAPS_API_KEY for address search).
                  <% end %>
                </p>
              </div>
              <div>
                <%= f.label :site_note, "Site note", class: "field-label" %>
                <%= f.text_area :site_note,
                                class: "field-input min-h-[5.5rem]",
                                rows: 3,
                                placeholder: "e.g. Enter via Gate 3, visitor parking on the left, ask for site office." %>
                <p class="field-hint">Gate number, closest parking, landmarks, or access instructions.</p>
              </div>
              <div class="flex flex-col sm:flex-row sm:items-center gap-3">
                <%= f.submit "Save site access", class: "btn-primary cursor-pointer" %>
                <button type="button" class="btn-secondary cursor-pointer" data-action="site-access#cancel">
                  Cancel
                </button>
              </div>
            <% end %>
          </div>
        </div>
      </section>
    <% end %>

    <section class="card">
      <div class="card-section">
        <h2 class="section-label mb-5">Timeline</h2>
        <ol>
          <% @inspection_request.status_timeline.each_with_index do |event, index| %>
            <li class="flex gap-3 pb-5 last:pb-0">
              <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-[10px] font-bold <%= timeline_marker_classes(event) %>">
                <%= timeline_marker_content(event, index) %>
              </span>
              <div>
                <p class="text-sm font-medium <%= 'text-red-700' if event[:failed] %>"><%= event[:label] %></p>
                <p class="text-xs text-[--color-ink-muted]">
                  <%= event[:at].present? ? format_datetime(event[:at]) : "—" %>
                  <% if event[:detail].present? %> · <%= event[:detail] %><% end %>
                </p>
              </div>
            </li>
          <% end %>
        </ol>
      </div>
    </section>
  </div>

  <aside class="job-detail-side space-y-6">
    <% if accepted_collapsible %>
      <%# Variation B (accepted, mobile): sticky summary peeks; tap expands form %>
      <div id="schedule-section"
           class="schedule-dock"
           data-controller="schedule-dock schedule-form"
           data-schedule-dock-expanded-class="is-expanded"
           data-schedule-dock-empty-label-value="Set schedule"
           data-schedule-form-target="section"
           data-action="change->schedule-dock#refreshSummary input->schedule-dock#refreshSummary">
        <div class="schedule-dock__shell">
          <button type="button"
                  class="schedule-dock__summary"
                  data-schedule-dock-target="toggle"
                  data-action="schedule-dock#toggle"
                  aria-expanded="true"
                  aria-controls="schedule-dock-panel">
            <span class="schedule-dock__handle" aria-hidden="true"></span>
            <span class="schedule-dock__summary-row">
              <span class="schedule-dock__summary-text" data-schedule-dock-target="summaryText">
                <%= schedule_summary_label(@inspection_request) %>
              </span>
              <svg class="schedule-dock__chevron" data-schedule-dock-target="chevron" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 9l6 6 6-6" />
              </svg>
            </span>
          </button>

          <div id="schedule-dock-panel"
               class="schedule-dock__panel"
               data-schedule-dock-target="panel">
            <div class="error-list hidden"
                 role="alert"
                 hidden
                 data-schedule-form-target="error">
              <p class="font-medium" data-schedule-form-target="errorText"></p>
            </div>

            <%= form_with url: schedule_dashboard_inspection_request_path(@inspection_request),
                          method: :patch,
                          html: {
                            id: "job-schedule-form",
                            class: "job-schedule-form space-y-3",
                            data: {
                              controller: "fsp-session-warning",
                              fsp_session_warning_url_value: dashboard_schedule_session_check_path,
                              fsp_session_warning_exclude_job_id_value: @inspection_request.id,
                              action: "submit->schedule-form#submit change->fsp-session-warning#check"
                            },
                            novalidate: true
                          } do %>
              <div class="job-schedule-form__when">
                <div class="job-schedule-form__field">
                  <label class="field-label" for="scheduled_on">Schedule date</label>
                  <input type="text"
                         name="inspection_request[scheduled_on]"
                         id="scheduled_on"
                         value="<%= @inspection_request.scheduled_on %>"
                         class="field-input"
                         placeholder="dd/mm/yyyy"
                         autocomplete="off"
                         data-controller="datepicker"
                         data-schedule-form-target="dateField"
                         data-fsp-session-warning-target="dateField"
                         data-action="change->schedule-form#clearError change->schedule-dock#refreshSummary change->fsp-session-warning#check"
                         inputmode="none">
                </div>
                <div class="job-schedule-form__field">
                  <span class="field-label" id="scheduled_time_label">Time</span>
                  <% selected_period = @inspection_request.scheduled_period %>
                  <div class="job-schedule-form__time" role="radiogroup" aria-labelledby="scheduled_time_label" aria-required="true">
                    <label class="inline-flex items-center gap-2 text-sm cursor-pointer">
                      <input type="radio" name="inspection_request[scheduled_time]" value="AM"
                             class="h-4 w-4 accent-[var(--color-accent)]"
                             data-action="change->schedule-form#clearError change->schedule-dock#refreshSummary change->fsp-session-warning#check"
                             <%= "checked" if selected_period == "AM" %>>
                      <span>AM</span>
                    </label>
                    <label class="inline-flex items-center gap-2 text-sm cursor-pointer">
                      <input type="radio" name="inspection_request[scheduled_time]" value="PM"
                             class="h-4 w-4 accent-[var(--color-accent)]"
                             data-action="change->schedule-form#clearError change->schedule-dock#refreshSummary change->fsp-session-warning#check"
                             <%= "checked" if selected_period == "PM" %>>
                      <span>PM</span>
                    </label>
                  </div>
                </div>
              </div>
              <div>
                <label class="field-label" for="fsp_id">Inspector / FSP</label>
                <select name="inspection_request[fsp_id]" id="fsp_id" class="field-select"
                        data-fsp-session-warning-target="fspSelect"
                        data-action="change->schedule-form#clearError change->schedule-dock#refreshSummary change->fsp-session-warning#check">
                  <option value="">Unassigned</option>
                  <% Fsp.ordered.each do |fsp| %>
                    <option value="<%= fsp.id %>" <%= "selected" if @inspection_request.fsp_id == fsp.id %>>
                      <%= fsp.display_name %>
                    </option>
                  <% end %>
                </select>
                <div class="field-warning-callout hidden mt-2"
                     role="status"
                     hidden
                     data-fsp-session-warning-target="warning">
                  <p class="field-warning-callout__text" data-fsp-session-warning-target="warningText"></p>
                </div>
              </div>
            <% end %>
          </div>

          <div class="schedule-dock__footer">
            <button type="submit"
                    form="job-schedule-form"
                    class="btn-primary w-full cursor-pointer">
              Mark scheduled
            </button>
          </div>
        </div>
      </div>
    <% elsif schedule_actions %>
      <%# Scheduled (and non-collapsible schedule UI) %>
      <div id="schedule-section"
           class="job-schedule-section space-y-3"
           data-controller="schedule-form"
           data-schedule-form-target="section">
        <div class="error-list hidden"
             role="alert"
             hidden
             data-schedule-form-target="error">
          <p class="font-medium" data-schedule-form-target="errorText"></p>
        </div>

        <section class="card">
          <div class="card-section space-y-3">
            <h2 class="section-label">Schedule</h2>
            <%= form_with url: schedule_dashboard_inspection_request_path(@inspection_request),
                          method: :patch,
                          html: {
                            id: "job-schedule-form",
                            class: "job-schedule-form space-y-3",
                            data: {
                              controller: "fsp-session-warning",
                              fsp_session_warning_url_value: dashboard_schedule_session_check_path,
                              fsp_session_warning_exclude_job_id_value: @inspection_request.id,
                              action: "submit->schedule-form#submit change->fsp-session-warning#check"
                            },
                            novalidate: true
                          } do %>
              <div class="job-schedule-form__when">
                <div class="job-schedule-form__field">
                  <label class="field-label" for="scheduled_on">Schedule date</label>
                  <input type="text"
                         name="inspection_request[scheduled_on]"
                         id="scheduled_on"
                         value="<%= @inspection_request.scheduled_on %>"
                         class="field-input"
                         placeholder="dd/mm/yyyy"
                         autocomplete="off"
                         data-controller="datepicker"
                         data-schedule-form-target="dateField"
                         data-fsp-session-warning-target="dateField"
                         data-action="change->schedule-form#clearError change->fsp-session-warning#check"
                         inputmode="none">
                </div>
                <div class="job-schedule-form__field">
                  <span class="field-label" id="scheduled_time_label">Time</span>
                  <% selected_period = @inspection_request.scheduled_period %>
                  <div class="job-schedule-form__time" role="radiogroup" aria-labelledby="scheduled_time_label" aria-required="true">
                    <label class="inline-flex items-center gap-2 text-sm cursor-pointer">
                      <input type="radio" name="inspection_request[scheduled_time]" value="AM"
                             class="h-4 w-4 accent-[var(--color-accent)]"
                             data-action="change->schedule-form#clearError change->fsp-session-warning#check"
                             <%= "checked" if selected_period == "AM" %>>
                      <span>AM</span>
                    </label>
                    <label class="inline-flex items-center gap-2 text-sm cursor-pointer">
                      <input type="radio" name="inspection_request[scheduled_time]" value="PM"
                             class="h-4 w-4 accent-[var(--color-accent)]"
                             data-action="change->schedule-form#clearError change->fsp-session-warning#check"
                             <%= "checked" if selected_period == "PM" %>>
                      <span>PM</span>
                    </label>
                  </div>
                </div>
              </div>
              <div>
                <label class="field-label" for="fsp_id">Inspector / FSP</label>
                <select name="inspection_request[fsp_id]" id="fsp_id" class="field-select"
                        data-fsp-session-warning-target="fspSelect"
                        data-action="change->schedule-form#clearError change->fsp-session-warning#check">
                  <option value="">Unassigned</option>
                  <% Fsp.ordered.each do |fsp| %>
                    <option value="<%= fsp.id %>" <%= "selected" if @inspection_request.fsp_id == fsp.id %>>
                      <%= fsp.display_name %>
                    </option>
                  <% end %>
                </select>
                <div class="field-warning-callout hidden mt-2"
                     role="status"
                     hidden
                     data-fsp-session-warning-target="warning">
                  <p class="field-warning-callout__text" data-fsp-session-warning-target="warningText"></p>
                </div>
              </div>
              <button type="submit" class="btn-secondary w-full cursor-pointer">
                Update schedule
              </button>
            <% end %>
          </div>
        </section>
      </div>
    <% end %>

    <% if show_actions_card %>
      <section class="card job-actions-bar<%= " job-actions-bar--sticky" if sticky_actions && !accepted_collapsible %><%= " job-actions-bar--cta-only" if @inspection_request.scheduled? %>">
        <div class="job-actions-bar__inner card-section space-y-3">
          <h2 class="section-label job-actions-bar__label">Actions</h2>

          <% if @inspection_request.pending? %>
            <p class="text-xs text-[--color-ink-muted] job-actions-pending-hint">
              Accepting creates a public status link you can share with the client.
            </p>
            <div class="job-actions-pending-row">
              <%= button_to "Accept request",
                            accept_dashboard_inspection_request_path(@inspection_request),
                            method: :patch,
                            class: "btn-primary w-full cursor-pointer",
                            form: {
                              class: "job-actions-pending-row__item",
                              data: {
                                turbo_confirm: "Are you sure you wish to accept this inspection request?\n\n" \
                                  "Once accepted, the status cannot be returned to pending. " \
                                  "The requestor will also receive a WhatsApp notification when the job is accepted."
                              }
                            } %>
              <%= button_to "Reject request",
                            reject_dashboard_inspection_request_path(@inspection_request),
                            method: :patch,
                            class: "btn-danger w-full cursor-pointer",
                            form: { class: "job-actions-pending-row__item", data: { turbo_confirm: "Reject this inspection request?" } } %>
            </div>
          <% end %>

          <% if @inspection_request.rejected? %>
            <p class="text-sm text-[--color-ink-muted]">This request was rejected.</p>
            <%= button_to "Re-open request",
                          reopen_dashboard_inspection_request_path(@inspection_request),
                          method: :patch,
                          class: "btn-secondary w-full cursor-pointer",
                          form: { data: { turbo_confirm: "Are you sure you want to re-open this request? It will return to pending status." } } %>
          <% end %>

          <% if @inspection_request.scheduled? %>
            <%= button_to "Mark completed",
                          complete_dashboard_inspection_request_path(@inspection_request),
                          method: :patch,
                          class: "btn-primary w-full cursor-pointer",
                          form: { data: { turbo_confirm: "Mark this inspection as completed?" } } %>
          <% end %>

          <% if @inspection_request.completed? %>
            <p class="text-sm text-[--color-ink-muted]">This job is complete.</p>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if @inspection_request.share_token.present? %>
      <section class="card">
        <div class="card-section space-y-3">
          <h2 class="section-label">Public status link</h2>
          <p class="text-sm text-[--color-ink-muted]">Share this with the client so they can follow progress.</p>
          <% url = public_status_url(@inspection_request.share_token) %>
          <div class="rounded-md border border-[--color-line] bg-stone-50 px-3 py-2 text-xs font-mono break-all text-[--color-ink]">
            <%= url %>
          </div>
          <%= link_to "Open public page", public_status_path(@inspection_request.share_token),
                      class: "btn-secondary w-full no-underline text-center", target: "_blank", rel: "noopener" %>
        </div>
      </section>
    <% end %>
  </aside>
</div>
