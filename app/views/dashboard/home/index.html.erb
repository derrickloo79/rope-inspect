<% content_for :title, "Dashboard — Hey Tec Inspect" %>

<div class="space-y-8">
  <div>
    <h1 class="page-title">Dashboard</h1>
    <p class="page-lede">Open work and the week ahead.</p>
  </div>

  <%# Status bento cards %>
  <div class="dash-stat-grid">
    <div class="card dash-stat-card dash-stat-card--pending">
      <div class="card-section dash-stat-card__inner">
        <p class="section-label">Pending</p>
        <div class="dash-stat-card__row">
          <p class="dash-stat-card__count"><%= @counts[:pending] %></p>
          <%= link_to dashboard_inspection_requests_path(status: "pending"),
                      class: "dash-link-arrow",
                      aria: { label: "See pending jobs" } do %>
            See jobs <span aria-hidden="true">→</span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="card dash-stat-card dash-stat-card--accepted">
      <div class="card-section dash-stat-card__inner">
        <p class="section-label">Accepted</p>
        <div class="dash-stat-card__row">
          <p class="dash-stat-card__count"><%= @counts[:accepted] %></p>
          <%= link_to dashboard_inspection_requests_path(status: "accepted"),
                      class: "dash-link-arrow",
                      aria: { label: "See accepted jobs" } do %>
            See jobs <span aria-hidden="true">→</span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="card dash-stat-card dash-stat-card--scheduled">
      <div class="card-section dash-stat-card__inner">
        <p class="section-label">Scheduled</p>
        <p class="dash-stat-card__count"><%= @counts[:scheduled] %></p>
      </div>
    </div>

    <div class="card dash-stat-card dash-stat-card--completed">
      <div class="card-section dash-stat-card__inner">
        <p class="section-label">Completed</p>
        <p class="dash-stat-card__count"><%= @counts[:completed] %></p>
      </div>
    </div>
  </div>

  <%= render "shared/upcoming_schedule",
             upcoming_by_day: @upcoming_by_day,
             job_path: :dashboard_inspection_request_path %>
</div>
