<% content_for :title, "Edit #{@fsp.fsp_number} — Hey Tec Inspect" %>

<div class="space-y-6 max-w-xl">
  <div>
    <%= link_to "← All FSPs", dashboard_fsps_path, class: "text-sm no-underline text-[--color-ink-muted] hover:text-[--color-ink]" %>
    <h1 class="page-title mt-3">Edit <%= @fsp.fsp_number %></h1>
    <p class="page-lede"><%= @fsp.full_name %></p>
  </div>

  <section class="card">
    <div class="card-section">
      <%= render "form", fsp: @fsp %>
    </div>
  </section>
</div>
