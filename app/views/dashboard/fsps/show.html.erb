<% content_for :title, "#{@fsp.fsp_number} — Hey Tec Inspect" %>

<div class="space-y-8">
  <div>
    <%= link_to "← All FSPs", dashboard_fsps_path, class: "text-sm no-underline text-ink-muted hover:text-ink" %>

    <div class="fsp-identity mt-4">
      <div class="fsp-identity__avatar" style="background-color: <%= @fsp.color %>;" title="<%= @fsp.color %>">
        <span class="fsp-identity__number"><%= @fsp.fsp_number %></span>
      </div>
      <div class="fsp-identity__body min-w-0">
        <h1 class="page-title"><%= @fsp.full_name %></h1>
        <p class="fsp-identity__meta">
          <span class="fsp-identity__item" title="WhatsApp: <%= @fsp.whatsapp_number %>">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            <%= @fsp.full_contact_number %>
          </span>
          <span class="fsp-identity__item">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m22 2-7 20-4-9-9-4Z" />
              <path d="M22 2 11 13" />
            </svg>
            <%= @fsp.email %>
          </span>
          <span class="fsp-identity__item">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M8 2v4" />
              <path d="M16 2v4" />
              <rect width="18" height="18" x="3" y="4" rx="2" />
              <path d="M3 10h18" />
            </svg>
            Joined <%= format_date(@fsp.date_joined) %>
          </span>
        </p>
      </div>
      <%= link_to "Edit", edit_dashboard_fsp_path(@fsp), class: "btn-secondary no-underline shrink-0" %>
    </div>
  </div>

  <section>
    <h2 class="section-label mb-4">Assigned jobs</h2>

    <% if @jobs.any? %>
      <div class="space-y-2">
        <%= render "shared/job_docs_legend" %>
        <div class="card overflow-hidden">
          <ul class="divide-y divide-line-soft">
            <% @jobs.each do |request| %>
              <%= render "shared/job_list_item",
                         request: request,
                         url: dashboard_inspection_request_path(request) %>
            <% end %>
          </ul>
        </div>
      </div>
    <% else %>
      <div class="text-center py-12 text-ink-muted">
        <p class="font-medium text-ink">No jobs assigned</p>
        <p class="text-sm mt-1">Jobs scheduled to this inspector will show up here.</p>
      </div>
    <% end %>
  </section>
</div>
