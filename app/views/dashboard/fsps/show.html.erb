<% content_for :title, "#{@fsp.fsp_number} — Hey Tec Inspect" %>

<div class="space-y-8">
  <div>
    <%= link_to "← All FSPs", dashboard_fsps_path, class: "text-sm no-underline text-ink-muted hover:text-ink" %>

    <div class="fsp-identity mt-4">
      <div class="fsp-identity__avatar" style="background-color: <%= @fsp.color %>;" title="<%= @fsp.color %>">
        <span class="fsp-identity__number"><%= @fsp.fsp_number %></span>
      </div>
      <div class="fsp-identity__body min-w-0">
        <h1 class="page-title"><%= @fsp.full_name %></h1>
        <p class="fsp-identity__meta">
          <span title="WhatsApp: <%= @fsp.whatsapp_number %>"><%= @fsp.full_contact_number %></span>
          <span class="fsp-identity__sep" aria-hidden="true">·</span>
          <span class="break-words"><%= @fsp.email %></span>
          <span class="fsp-identity__sep" aria-hidden="true">·</span>
          <span>Joined <%= format_date(@fsp.date_joined) %></span>
        </p>
      </div>
      <%= link_to "Edit", edit_dashboard_fsp_path(@fsp), class: "btn-secondary no-underline shrink-0" %>
    </div>
  </div>

  <section>
    <h2 class="section-label mb-4">Assigned jobs</h2>

    <% if @jobs.any? %>
      <div class="space-y-2">
        <%= render "shared/job_docs_legend" %>
        <div class="card overflow-hidden">
          <ul class="divide-y divide-line-soft">
            <% @jobs.each do |request| %>
              <%= render "shared/job_list_item",
                         request: request,
                         url: dashboard_inspection_request_path(request) %>
            <% end %>
          </ul>
        </div>
      </div>
    <% else %>
      <div class="text-center py-12 text-ink-muted">
        <p class="font-medium text-ink">No jobs assigned</p>
        <p class="text-sm mt-1">Jobs scheduled to this inspector will show up here.</p>
      </div>
    <% end %>
  </section>
</div>
