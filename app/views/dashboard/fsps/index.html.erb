<% content_for :title, "FSPs — Hey Tec Inspect" %>

<div class="space-y-8">
  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
    <div>
      <h1 class="page-title">FSPs</h1>
      <p class="page-lede">Inspectors assigned to rope inspection jobs.</p>
    </div>
    <%= link_to "Add FSP", new_dashboard_fsp_path, class: "btn-primary no-underline shrink-0" %>
  </div>

  <% if @fsps.any? %>
    <div class="card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
          <thead class="text-[--color-ink-muted] border-b border-line-soft">
            <tr>
              <th class="table-th">FSP</th>
              <th class="table-th">Full name</th>
              <th class="table-th">Contact</th>
              <th class="table-th">Email</th>
              <th class="table-th">Joined</th>
              <th class="table-th text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line-soft">
            <% @fsps.each do |fsp| %>
              <tr class="fsp-list-row hover:bg-stone-50"
                  tabindex="0"
                  role="link"
                  aria-label="View <%= fsp.display_name %>"
                  data-controller="clickable-row"
                  data-clickable-row-url-value="<%= dashboard_fsp_path(fsp) %>"
                  data-action="click->clickable-row#go keydown->clickable-row#keydown">
                <td class="fsp-list-id-cell px-5 py-3">
                  <span class="fsp-list-id">
                    <span class="fsp-color-swatch" style="background-color: <%= fsp.color %>;" title="<%= fsp.color %>"></span>
                    <span class="fsp-list-id__number"><%= fsp.fsp_number %></span>
                  </span>
                </td>
                <td class="px-5 py-3 align-middle font-medium text-[--color-ink]"><%= fsp.full_name %></td>
                <td class="px-5 py-3 align-middle text-[--color-ink-muted] whitespace-nowrap" title="WhatsApp: <%= fsp.whatsapp_number %>">
                  <%= fsp.full_contact_number %>
                </td>
                <td class="px-5 py-3 align-middle text-[--color-ink-muted]"><%= fsp.email %></td>
                <td class="px-5 py-3 align-middle text-[--color-ink-muted] whitespace-nowrap"><%= format_date(fsp.date_joined) %></td>
                <td class="px-5 py-3 align-middle text-right whitespace-nowrap">
                  <%= render "shared/row_actions",
                             edit_path: edit_dashboard_fsp_path(fsp),
                             delete_path: dashboard_fsp_path(fsp),
                             delete_confirm: "Delete #{fsp.fsp_number} (#{fsp.full_name})?" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="text-center py-12 text-[--color-ink-muted]">
      <p class="font-medium text-[--color-ink]">No FSPs yet</p>
      <p class="text-sm mt-1">
        <%= link_to "Add the first FSP", new_dashboard_fsp_path %> to start assigning inspectors.
      </p>
    </div>
  <% end %>
</div>
