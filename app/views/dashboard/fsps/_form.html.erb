<% if fsp.errors.any? %>
  <div class="error-list" role="alert">
    <p class="font-medium">Please fix the following:</p>
    <ul class="list-disc list-inside mt-1">
      <% fsp.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: [:dashboard, fsp], class: "space-y-5" do |f| %>
  <% if fsp.persisted? %>
    <div>
      <p class="field-label">FSP number</p>
      <p class="font-mono font-medium text-[--color-ink]"><%= fsp.fsp_number %></p>
      <p class="field-hint">Assigned automatically and cannot be changed.</p>
    </div>
  <% else %>
    <p class="text-sm text-[--color-ink-muted]">
      FSP number will be assigned automatically (next available <span class="font-mono">FSP…</span>).
    </p>
  <% end %>

  <div>
    <%= f.label :full_name, "Full name", class: "field-label" %>
    <%= f.text_field :full_name, class: "field-input", required: true, autocomplete: "name" %>
  </div>

  <div>
    <%= f.label :contact_number, "Contact number", class: "field-label" %>
    <div class="grid grid-cols-4 gap-2" data-controller="country-code-select">
      <div class="col-span-1 min-w-0">
        <%= f.select :country_code,
                     country_code_select_options(fsp.country_code),
                     {},
                     country_code_select_html_options %>
      </div>
      <div class="col-span-3 min-w-0">
        <%= f.telephone_field :contact_number,
                              class: "field-input",
                              required: true,
                              placeholder: "91234567",
                              autocomplete: "tel-national",
                              inputmode: "numeric",
                              pattern: "[0-9]+",
                              title: "Digits only",
                              data: {
                                controller: "digits-only",
                                action: "input->digits-only#filter"
                              } %>
      </div>
    </div>
    <p class="field-hint">Country code is required for WhatsApp. Enter the local number without the country code.</p>
  </div>

  <div>
    <%= f.label :email, "Email address (login)", class: "field-label" %>
    <%= f.email_field :email, class: "field-input", required: true, autocomplete: "email" %>
    <p class="field-hint">Used by the FSP to sign in to their job portal.</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div>
      <%= f.label :password, fsp.persisted? ? "New password" : "Password", class: "field-label" %>
      <%= render "shared/password_field", f: f, method: :password, required: !fsp.persisted? %>
      <% if fsp.persisted? %>
        <p class="field-hint">Leave blank to keep the current password. Min <%= Devise.password_length.min %> characters.</p>
      <% else %>
        <p class="field-hint">Min <%= Devise.password_length.min %> characters. Used with email to sign in at /fsp/sign_in.</p>
      <% end %>
    </div>
    <div>
      <%= f.label :password_confirmation, "Confirm password", class: "field-label" %>
      <%= render "shared/password_field", f: f, method: :password_confirmation, required: !fsp.persisted? %>
    </div>
  </div>

  <div>
    <%= f.label :date_joined, "Date joined", class: "field-label" %>
    <%= f.date_field :date_joined, class: "field-input", required: true %>
  </div>

  <% if fsp.persisted? %>
    <%
      selected_color = fsp.color.to_s.downcase
      palette = Fsp::COLOR_PALETTE
      # Keep a legacy color visible if it isn't in the current 8-swatch set.
      unless palette.any? { |c| c.casecmp?(fsp.color.to_s) }
        palette = palette + [ fsp.color ]
      end
    %>
    <div>
      <p class="field-label" id="fsp-color-label">Color</p>
      <div class="fsp-color-picker" role="radiogroup" aria-labelledby="fsp-color-label">
        <% palette.each do |hex| %>
          <label class="fsp-color-option">
            <%= f.radio_button :color, hex,
                               checked: hex.casecmp?(selected_color) || (selected_color.blank? && hex == Fsp::COLOR_PALETTE.first),
                               class: "fsp-color-option__input" %>
            <span class="fsp-color-option__swatch" style="background-color: <%= hex %>;" title="<%= hex %>">
              <svg class="fsp-color-option__check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12l5 5L20 7" />
              </svg>
            </span>
          </label>
        <% end %>
      </div>
      <p class="field-hint">Used to distinguish this FSP on the planner and job views. Each color can only be used once.</p>
    </div>
  <% else %>
    <p class="text-sm text-[--color-ink-muted]">
      A unique color is assigned automatically when the FSP is created (you can change it later).
    </p>
  <% end %>

  <div class="flex flex-col sm:flex-row sm:items-center gap-3 pt-2">
    <%= f.submit fsp.persisted? ? "Save changes" : "Create FSP", class: "btn-primary cursor-pointer" %>
    <%= link_to "Cancel",
                fsp.persisted? ? dashboard_fsp_path(fsp) : dashboard_fsps_path,
                class: "btn-secondary no-underline text-center" %>
  </div>
<% end %>
