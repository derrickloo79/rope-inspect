<% if user.errors.any? %>
  <div class="error-list" role="alert">
    <p class="font-medium">Please fix the following:</p>
    <ul class="list-disc list-inside mt-1">
      <% user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: [:dashboard, user], class: "space-y-5" do |f| %>
  <div>
    <%= f.label :name, "Name", class: "field-label" %>
    <%= f.text_field :name, class: "field-input", required: true, autocomplete: "name" %>
  </div>

  <div>
    <%= f.label :email, "Email address (login)", class: "field-label" %>
    <%= f.email_field :email, class: "field-input", required: true, autocomplete: "email" %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div>
      <%= f.label :password, user.persisted? ? "New password" : "Password", class: "field-label" %>
      <%= f.password_field :password,
                          class: "field-input",
                          required: !user.persisted?,
                          autocomplete: "new-password",
                          minlength: Devise.password_length.min,
                          value: nil %>
      <% if user.persisted? %>
        <p class="field-hint">Leave blank to keep the current password.</p>
      <% else %>
        <p class="field-hint">Min <%= Devise.password_length.min %> characters.</p>
      <% end %>
    </div>
    <div>
      <%= f.label :password_confirmation, "Confirm password", class: "field-label" %>
      <%= f.password_field :password_confirmation,
                          class: "field-input",
                          required: !user.persisted?,
                          autocomplete: "new-password",
                          minlength: Devise.password_length.min,
                          value: nil %>
    </div>
  </div>

  <div class="flex flex-col sm:flex-row sm:items-center gap-3 pt-2">
    <%= f.submit user.persisted? ? "Save changes" : "Create admin", class: "btn-primary cursor-pointer" %>
    <%= link_to "Cancel", dashboard_users_path, class: "btn-secondary no-underline text-center" %>
  </div>
<% end %>
