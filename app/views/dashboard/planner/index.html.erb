<% content_for :title, "Planner — Hey Tec Inspect" %>

<div class="planner planner--wide space-y-10"
     data-controller="planner-schedule">
  <div>
    <h1 class="page-title">Planner</h1>
    <p class="page-lede">Schedule accepted jobs and scan the week ahead. Click a card to set date, time, and inspector.</p>
  </div>

  <%# Section A: Accepted jobs ready to schedule %>
  <section class="space-y-4" aria-labelledby="planner-accepted-heading">
    <div class="flex gap-2">
      <span class="planner-accepted-header__title">Accepted</span>
      <span class="planner-accepted-header__counter">(<%= @accepted_jobs.size %>)</span>
    </div>

    <% if @accepted_jobs.any? %>
      <div class="planner-accepted-grid">
        <% @accepted_jobs.each do |job| %>
          <button type="button"
                  class="planner-accepted-card text-left"
                  data-action="planner-schedule#open"
                  data-planner-schedule-job-id-param="<%= job.id %>"
                  data-planner-schedule-title-param="<%= job.site_name %>"
                  data-planner-schedule-subtitle-param="<%= job.company_name %> · <%= job.reference_code %>"
                  data-planner-schedule-date-param="<%= job.scheduled_on %>"
                  data-planner-schedule-period-param="<%= job.scheduled_period %>"
                  data-planner-schedule-fsp-id-param="<%= job.fsp_id %>">
            <p class="planner-accepted-card__title"><%= job.site_name %></p>
            <p class="planner-accepted-card__meta">
              <%= job.company_name %>
              · <%= pluralize(job.cranes.size, "crane") %>
              · <%= job.reference_code %>
            </p>
            <span class="planner-accepted-card__cta">Schedule →</span>
          </button>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-ink-muted py-4">No accepted jobs waiting to schedule.</p>
    <% end %>
  </section>

  <%# Section B: Weekly calendar (Turbo Frame — filter/week nav refresh only this block) %>
  <% planner_query = { week: @week_start.iso8601 } %>
  <% planner_query[:fsp_id] = @fsp_filter if @fsp_filter.present? %>
  <%= turbo_frame_tag "planner_week", class: "block space-y-4" do %>
    <section class="space-y-4" aria-labelledby="planner-week-heading">
      <div class="planner-week-header">
        <h2 id="planner-week-heading" class="planner-week-range">
          <%= format_week_range(@week_start, @week_end) %>
        </h2>

        <% current_week_start = Date.current.beginning_of_week(:monday) %>
        <div class="planner-week-toggles" role="group" aria-label="Change week">
          <%= link_to dashboard_planner_path(planner_query.merge(week: (@week_start - 7.days).iso8601)),
                      class: "planner-week-toggle no-underline",
                      data: { turbo_action: "advance" },
                      aria: { label: "Previous week" } do %>
            ←
          <% end %>
          <%= link_to dashboard_planner_path(planner_query.merge(week: (@week_start + 7.days).iso8601)),
                      class: "planner-week-toggle no-underline",
                      data: { turbo_action: "advance" },
                      aria: { label: "Next week" } do %>
            →
          <% end %>
          <% if @week_start != current_week_start %>
            <%= link_to "Today",
                        dashboard_planner_path(planner_query.merge(week: current_week_start.iso8601)),
                        class: "planner-week-today btn-primary no-underline",
                        data: { turbo_action: "advance" },
                        aria: { label: "Go to current week" } %>
          <% end %>
        </div>

        <div class="planner-week-divider" aria-hidden="true"></div>

        <div class="planner-week-filter">
          <%= form_with url: dashboard_planner_path,
                        method: :get,
                        class: "planner-week-filter__form",
                        data: { turbo_frame: "planner_week", turbo_action: "advance" } do %>
            <%= hidden_field_tag :week, @week_start.iso8601 %>
            <label for="planner-fsp-filter" class="sr-only">Filter by FSP</label>
            <%= select_tag :fsp_id,
                           options_for_select(
                             [[ "All FSPs", "" ]] + @fsps.map { |f| [ "#{f.fsp_number} · #{f.full_name}", f.id ] },
                             @fsp_filter
                           ),
                           id: "planner-fsp-filter",
                           class: "planner-week-filter__select field-select",
                           onchange: "this.form.requestSubmit()" %>
          <% end %>
        </div>
      </div>

      <div class="planner-calendar-scroll">
        <div class="planner-calendar" role="grid" aria-label="Scheduled jobs this week">
          <% @week_days.each do |day| %>
            <% jobs = @scheduled_by_day[day] || [] %>
            <div class="planner-day<%= " is-today" if day == Date.current %>" role="gridcell">
              <div class="planner-day__header">
                <span class="planner-day__weekday"><%= day.strftime("%a") %></span>
                <span class="planner-day__date"><%= day.strftime("%-d") %></span>
              </div>
              <div class="planner-day__body">
                <% if jobs.any? %>
                  <% jobs.each do |job| %>
                    <% chip_style = job.fsp.present? ? "background-color: #{job.fsp.color};" : nil %>
                    <button type="button"
                            class="planner-chip text-left<%= " planner-chip--colored" if job.fsp.present? %>"
                            style="<%= chip_style %>"
                            title="<%= job.fsp&.display_name %>"
                            data-action="planner-schedule#open"
                            data-planner-schedule-job-id-param="<%= job.id %>"
                            data-planner-schedule-title-param="<%= job.site_name %>"
                            data-planner-schedule-subtitle-param="<%= job.company_name %> · <%= job.reference_code %>"
                            data-planner-schedule-date-param="<%= job.scheduled_on %>"
                            data-planner-schedule-period-param="<%= job.scheduled_period %>"
                            data-planner-schedule-fsp-id-param="<%= job.fsp_id %>">
                      <span class="planner-chip__site"><%= job.site_name %></span>
                      <span class="planner-chip__company">
                        <%= job.company_name %> · <%= pluralize(job.cranes.size, "crane") %>
                      </span>
                      <span class="planner-chip__meta">
                        <% if job.scheduled_period.present? %>
                          <span class="dash-period-pill dash-period-pill--<%= job.scheduled_period.downcase %>"><%= job.scheduled_period %></span>
                        <% end %>
                        <% if job.fsp.present? %>
                          <span class="planner-chip__fsp-number"><%= job.fsp.fsp_number %></span>
                        <% end %>
                      </span>
                    </button>
                  <% end %>
                <% else %>
                  <p class="planner-day__empty">—</p>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <%# Schedule modal (outside turbo frame so it stays mounted) %>
  <div class="planner-schedule-modal"
       data-planner-schedule-target="dialog"
       data-action="click->planner-schedule#backdropClose"
       hidden>
    <div class="planner-schedule-modal__dialog"
         role="dialog"
         aria-modal="true"
         aria-labelledby="planner-schedule-title">
      <div class="planner-schedule-modal__header">
        <div class="min-w-0">
          <h2 id="planner-schedule-title" class="planner-schedule-modal__title" data-planner-schedule-target="title">
            Schedule inspection
          </h2>
          <p class="planner-schedule-modal__subtitle" data-planner-schedule-target="subtitle"></p>
        </div>
        <button type="button"
                class="planner-schedule-modal__close"
                data-action="planner-schedule#close"
                aria-label="Close">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6L6 18" />
            <path d="M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="error-list hidden"
           role="alert"
           hidden
           data-planner-schedule-target="error">
        <p class="font-medium" data-planner-schedule-target="errorText"></p>
      </div>

      <%= form_with url: "#",
                    method: :patch,
                    html: {
                      id: "planner-schedule-form",
                      class: "space-y-4",
                      data: {
                        controller: "fsp-session-warning",
                        fsp_session_warning_url_value: dashboard_schedule_session_check_path,
                        planner_schedule_target: "form",
                        action: "submit->planner-schedule#submit change->fsp-session-warning#check"
                      },
                      novalidate: true
                    } do %>
        <input type="hidden" name="return_to" value="planner">
        <input type="hidden" name="week" value="<%= @week_start.iso8601 %>">
        <input type="hidden" name="fsp_filter" value="<%= @fsp_filter %>">

        <div>
          <label class="field-label" for="planner_scheduled_on">Schedule date</label>
          <input type="text"
                 name="inspection_request[scheduled_on]"
                 id="planner_scheduled_on"
                 class="field-input"
                 placeholder="dd/mm/yyyy"
                 autocomplete="off"
                 data-controller="datepicker"
                 data-datepicker-position-value="below"
                 data-planner-schedule-target="dateField"
                 data-fsp-session-warning-target="dateField"
                 data-action="change->fsp-session-warning#check"
                 inputmode="none">
        </div>

        <div>
          <span class="field-label" id="planner_scheduled_time_label">Time</span>
          <div class="job-schedule-form__time" role="radiogroup" aria-labelledby="planner_scheduled_time_label" aria-required="true">
            <label class="inline-flex items-center gap-2 text-sm cursor-pointer">
              <input type="radio"
                     name="inspection_request[scheduled_time]"
                     value="AM"
                     class="h-4 w-4 accent-[var(--color-accent)]"
                     data-planner-schedule-target="periodAm"
                     data-action="change->fsp-session-warning#check">
              <span>AM</span>
            </label>
            <label class="inline-flex items-center gap-2 text-sm cursor-pointer">
              <input type="radio"
                     name="inspection_request[scheduled_time]"
                     value="PM"
                     class="h-4 w-4 accent-[var(--color-accent)]"
                     data-planner-schedule-target="periodPm"
                     data-action="change->fsp-session-warning#check">
              <span>PM</span>
            </label>
          </div>
        </div>

        <div>
          <label class="field-label" for="planner_fsp_id">Inspector / FSP</label>
          <select name="inspection_request[fsp_id]"
                  id="planner_fsp_id"
                  class="field-select"
                  data-planner-schedule-target="fspSelect"
                  data-fsp-session-warning-target="fspSelect"
                  data-action="change->fsp-session-warning#check">
            <option value="">Unassigned</option>
            <% @fsps.each do |fsp| %>
              <option value="<%= fsp.id %>"><%= fsp.display_name %></option>
            <% end %>
          </select>
          <div class="field-warning-callout hidden mt-2"
               role="status"
               hidden
               data-fsp-session-warning-target="warning">
            <p class="field-warning-callout__text" data-fsp-session-warning-target="warningText"></p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center gap-3 pt-1">
          <button type="submit" class="btn-primary cursor-pointer">
            Save schedule
          </button>
          <button type="button" class="btn-secondary cursor-pointer" data-action="planner-schedule#close">
            Cancel
          </button>
        </div>
      <% end %>

      <p class="planner-schedule-modal__footer">
        <%= link_to "Open full job details",
                    "#",
                    class: "text-sm no-underline",
                    data: { planner_schedule_target: "viewJob", turbo_frame: "_top" } %>
      </p>
    </div>
  </div>
</div>
