<% content_for :title, "My profile — Hey Tec Inspect" %>

<div class="space-y-6 max-w-xl">
  <div>
    <h1 class="page-title">My profile</h1>
    <p class="page-lede">Update your name, contact number, and password. Login email: <span class="font-medium text-[--color-ink]"><%= @user.email %></span></p>
  </div>

  <section class="card">
    <div class="card-section">
      <% if @user.errors.any? %>
        <div class="error-list" role="alert">
          <p class="font-medium">Please fix the following:</p>
          <ul class="list-disc list-inside mt-1">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @user, url: dashboard_profile_path, method: :patch, class: "space-y-5" do |f| %>
        <div>
          <%= f.label :name, "Name", class: "field-label" %>
          <%= f.text_field :name, class: "field-input", required: true, autocomplete: "name" %>
        </div>

        <div>
          <p class="field-label">Email address (login)</p>
          <p class="font-medium text-[--color-ink]"><%= @user.email %></p>
          <p class="field-hint">Email can be changed by an admin under Admins.</p>
        </div>

        <div>
          <%= f.label :contact_number, "Contact number", class: "field-label" %>
          <div class="flex gap-2">
            <%= f.select :country_code,
                         options_for_select(User::COUNTRY_CODES, @user.country_code.presence || User::DEFAULT_COUNTRY_CODE),
                         {},
                         class: "field-select !w-auto min-w-[11rem] shrink-0",
                         required: true,
                         aria: { label: "Country code" } %>
            <%= f.telephone_field :contact_number,
                                  class: "field-input min-w-0 flex-1",
                                  required: true,
                                  placeholder: "91234567",
                                  autocomplete: "tel-national",
                                  inputmode: "tel" %>
          </div>
          <p class="field-hint">Country code is required for WhatsApp. Enter the local number without the country code.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <%= f.label :password, "New password", class: "field-label" %>
            <%= f.password_field :password,
                                class: "field-input",
                                autocomplete: "new-password",
                                minlength: Devise.password_length.min,
                                value: nil %>
            <p class="field-hint">Leave blank to keep your current password. Min <%= Devise.password_length.min %> characters.</p>
          </div>
          <div>
            <%= f.label :password_confirmation, "Confirm password", class: "field-label" %>
            <%= f.password_field :password_confirmation,
                                class: "field-input",
                                autocomplete: "new-password",
                                minlength: Devise.password_length.min,
                                value: nil %>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center gap-3 pt-2">
          <%= f.submit "Save profile", class: "btn-primary cursor-pointer" %>
          <%= link_to "Cancel", dashboard_root_path, class: "btn-secondary no-underline text-center" %>
        </div>
      <% end %>
    </div>
  </section>
</div>
