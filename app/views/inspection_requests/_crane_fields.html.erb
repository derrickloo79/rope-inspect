<% skip_certificates = local_assigns.fetch(:skip_certificates, false) %>
<div class="rounded-md border border-stone-200 bg-stone-50/60 p-4 space-y-4"
     data-nested-form-target="item"
     data-request-form-steps-target="craneItem">
  <%= f.hidden_field :id if f.object.persisted? %>
  <%= f.hidden_field :_destroy, value: "0" %>
  <%= f.hidden_field :position if f.object.persisted? %>

  <%# Step 1: crane details %>
  <div data-request-form-steps-target="craneDetails">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:gap-3"
         data-controller="crane-type-other">
      <div class="min-w-0 w-full sm:flex-1">
        <%= f.label :crane_type, "Crane type", class: "field-label" %>
        <%= f.select :crane_type,
                     Crane::CRANE_TYPES.map { |value, label| [label, value] },
                     { prompt: "Select type" },
                     class: "field-select",
                     required: true,
                     data: {
                       crane_type_other_target: "select",
                       request_form_steps_target: "craneType",
                       action: "change->crane-type-other#toggle"
                     } %>
      </div>

      <div class="min-w-0 w-full sm:flex-1"
           <% unless f.object.others? %>hidden<% end %>
           data-crane-type-other-target="other">
        <label class="field-label hidden sm:block invisible" aria-hidden="true">Specify type</label>
        <%= f.text_field :crane_type_other,
                         class: "field-input",
                         placeholder: "e.g. cable car",
                         maxlength: 80,
                         autocomplete: "off",
                         aria: { label: "Specify crane type" },
                         required: f.object.others?,
                         data: { request_form_steps_target: "craneTypeOther" } %>
      </div>

      <div class="min-w-0 w-full sm:flex-1">
        <%= f.label :lm_number, "LM number", class: "field-label" %>
        <%= f.text_field :lm_number,
                         class: "field-input",
                         required: true,
                         placeholder: "e.g. LM12345",
                         data: { request_form_steps_target: "craneLm" } %>
      </div>

      <div class="min-w-0 w-full sm:flex-1">
        <%= f.label :rope_diameter_mm, "Rope diameter (mm)", class: "field-label" %>
        <%= f.text_field :rope_diameter_mm,
                           class: "field-input",
                           required: true,
                           placeholder: "e.g. 20 / 21 / 26" %>
      </div>

      <div class="flex justify-end sm:shrink-0 sm:justify-start sm:pt-7">
        <button type="button"
                class="btn-danger-icon"
                data-action="nested-form#remove"
                data-nested-form-target="remove"
                data-request-form-steps-target="craneRemove"
                aria-label="Remove crane"
                title="Remove crane">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 6h18" />
            <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
            <path d="M10 11v6" />
            <path d="M14 11v6" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <%# Step 2: optional certificates for this crane (public request form only) %>
  <% unless skip_certificates %>
  <div data-request-form-steps-target="craneDocs" hidden>
    <p class="text-sm font-medium text-ink mb-3" data-request-form-steps-target="craneSummary">
      Crane
    </p>

    <div class="space-y-4">
      <div>
        <%= f.label :lm_certificate, "LM certificate", class: "field-label" %>
        <div class="file-dropzone"
             data-controller="file-dropzone"
             data-action="dragover->file-dropzone#dragover dragleave->file-dropzone#dragleave drop->file-dropzone#drop">
          <%= f.file_field :lm_certificate,
                           id: f.field_id(:lm_certificate),
                           class: "sr-only",
                           accept: "application/pdf,image/jpeg,image/png,.pdf,.jpg,.jpeg,.png",
                           data: {
                             file_dropzone_target: "input",
                             action: "change->file-dropzone#changed"
                           } %>
          <div class="file-dropzone__pending" data-file-dropzone-target="pending" hidden>
            <div class="file-dropzone__pending-list" data-file-dropzone-target="list"></div>
          </div>
          <label class="file-dropzone__label"
                 for="<%= f.field_id(:lm_certificate) %>"
                 data-file-dropzone-target="prompt">
            <span>
              <span class="file-dropzone__action">Upload a file</span><span class="file-dropzone__or"> or drag and drop</span>
            </span>
            <span class="file-dropzone__hint">Optional · PDF, JPG, or PNG · up to 15 MB</span>
          </label>
        </div>
      </div>

      <div>
        <%= f.label :mill_certificates, "Mill certificate(s)", class: "field-label" %>
        <div class="file-dropzone"
             data-controller="file-dropzone"
             data-action="dragover->file-dropzone#dragover dragleave->file-dropzone#dragleave drop->file-dropzone#drop">
          <%= f.file_field :mill_certificates,
                           id: f.field_id(:mill_certificates),
                           multiple: true,
                           class: "sr-only",
                           accept: "application/pdf,image/jpeg,image/png,.pdf,.jpg,.jpeg,.png",
                           data: {
                             file_dropzone_target: "input",
                             action: "change->file-dropzone#changed"
                           } %>
          <div class="file-dropzone__pending" data-file-dropzone-target="pending" hidden>
            <div class="file-dropzone__pending-list" data-file-dropzone-target="list"></div>
          </div>
          <label class="file-dropzone__label"
                 for="<%= f.field_id(:mill_certificates) %>"
                 data-file-dropzone-target="prompt">
            <span>
              <span class="file-dropzone__action">Upload files</span><span class="file-dropzone__or"> or drag and drop</span>
            </span>
            <span class="file-dropzone__hint">Optional · one or more PDF, JPG, or PNG · up to 15 MB each</span>
          </label>
        </div>
      </div>
    </div>
  </div>
  <% end %>
</div>
