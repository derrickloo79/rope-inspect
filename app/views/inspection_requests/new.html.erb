<% content_for :title, "Request a rope inspection — RopeInspect" %>

<div class="space-y-8">
  <div>
    <h1 class="page-title">Rope Inspection Request Form</h1>
    <p class="page-lede">
      Tell us who you are, where the site is, and which cranes need inspecting.
      We’ll review the request and get back to you via Whatsapp with a schedule.
    </p>
  </div>

  <% if @inspection_request.errors.any? %>
    <div class="error-list" role="alert">
      <p class="font-medium">Please fix the following:</p>
      <ul class="list-disc list-inside mt-1">
        <% @inspection_request.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @inspection_request, url: inspection_requests_path, class: "space-y-6", data: { controller: "nested-form" } do |f| %>
    <section class="card">
      <div class="card-section">
        <h2 class="section-label mb-4">Requestor details</h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <%= f.label :company_name, "Company name", class: "field-label" %>
            <%= f.text_field :company_name, class: "field-input", required: true, placeholder: "e.g. Acme Pte Ltd", autocomplete: "organization" %>
          </div>

          <div>
            <%= f.label :site_name, "Site / location", class: "field-label" %>
            <%= f.text_field :site_name, class: "field-input", required: true, placeholder: "e.g. Seletar South Link, N109, etc.." %>
            <p class="field-hint">Construction site name, address, or plot reference.</p>
          </div>

          <div>
            <%= f.label :requestor_name, "Your name", class: "field-label" %>
            <%= f.text_field :requestor_name, class: "field-input", required: true, placeholder: "e.g. John Doe", autocomplete: "name" %>
          </div>

          <div>
            <%= f.label :contact_number, "Contact number", class: "field-label" %>
            <%= f.telephone_field :contact_number, class: "field-input", required: true, placeholder: "e.g. 91234567", autocomplete: "tel" %>
          </div>
        </div>
      </div>
    </section>

    <section class="card">
      <div class="card-section">
        <div class="flex items-start justify-between gap-4 mb-4">
          <div>
            <h2 class="section-label">Cranes to inspect</h2>
            <p class="text-sm text-[--color-ink-muted] mt-1">Add every lifting machine that needs a rope inspection.</p>
          </div>
          <button type="button" class="btn-secondary !py-1.5 !px-3 text-sm shrink-0" data-action="nested-form#add">
            + Add crane
          </button>
        </div>

        <div class="space-y-4" data-nested-form-target="container">
          <%= f.fields_for :cranes do |crane_form| %>
            <%= render "crane_fields", f: crane_form %>
          <% end %>
        </div>

        <template data-nested-form-target="template">
          <%= f.fields_for :cranes, Crane.new, child_index: "NEW_RECORD" do |crane_form| %>
            <%= render "crane_fields", f: crane_form %>
          <% end %>
        </template>
      </div>
    </section>

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pt-1">
      <%= f.submit "Submit request", class: "btn-primary cursor-pointer" %>
    </div>
  <% end %>
</div>
