<% content_for :title, "#{@job.reference_code} — Dashboard" %>

<div class="space-y-6">
  <div>
    <%= link_to "← Dashboard", portal_root_path, class: "text-sm no-underline text-ink-muted hover:text-ink" %>
    <div class="mt-3 job-detail-heading">
      <% if @job.scheduled_on.present? %>
        <div class="job-cal" aria-label="<%= @job.scheduled_on.strftime("%-d %B") %><%= " #{@job.scheduled_period}" if @job.scheduled_period.present? %>">
          <div class="job-cal__badge">
            <span class="job-cal__month"><%= @job.scheduled_on.strftime("%b") %></span>
            <span class="job-cal__day"><%= @job.scheduled_on.strftime("%-d") %></span>
            <% if @job.scheduled_period.present? %>
              <span class="job-cal__period job-cal__period--<%= @job.scheduled_period.downcase %>">
                <%= @job.scheduled_period %>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>
      <div class="job-detail-heading__body min-w-0">
        <h1 class="page-title"><%= @job.site_name %></h1>
        <p class="page-lede"><%= @job.company_name %> · <%= @job.reference_code %></p>
        <div class="mt-2"><%= status_badge(@job.status) %></div>
      </div>
    </div>
  </div>

  <% if @job.scheduled_on.present? || @job.scheduled_period.present? %>
    <section class="card">
      <div class="card-section">
        <h2 class="section-label mb-4">Schedule</h2>
        <dl class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
          <div>
            <dt class="text-[--color-ink-muted]">Date</dt>
            <dd class="font-medium mt-0.5"><%= format_date(@job.scheduled_on) %></dd>
          </div>
          <div>
            <dt class="text-[--color-ink-muted]">Time</dt>
            <dd class="font-medium mt-0.5"><%= @job.scheduled_period.presence || "—" %></dd>
          </div>
          <div>
            <dt class="text-[--color-ink-muted]">Assigned to</dt>
            <dd class="font-medium mt-0.5"><%= @job.inspector_label.presence || "—" %></dd>
          </div>
        </dl>
      </div>
    </section>
  <% end %>

  <section class="card">
    <div class="card-section">
      <h2 class="section-label mb-4">Site &amp; requestor</h2>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
        <div class="min-w-0">
          <dt class="text-ink-muted">Site</dt>
          <dd class="font-medium mt-0.5 break-words"><%= @job.site_name %></dd>
        </div>
        <div class="min-w-0">
          <dt class="text-ink-muted">Company</dt>
          <dd class="font-medium mt-0.5 break-words"><%= @job.company_name %></dd>
        </div>
        <div class="min-w-0">
          <dt class="text-ink-muted">Requestor</dt>
          <dd class="font-medium mt-0.5 break-words"><%= @job.requestor_name %></dd>
        </div>
        <div class="min-w-0">
          <dt class="text-ink-muted">Phone</dt>
          <dd class="font-medium mt-0.5 break-words" title="WhatsApp: <%= @job.whatsapp_number %>">
            <%= @job.full_contact_number %>
          </dd>
        </div>
        <div class="min-w-0">
          <dt class="text-ink-muted">Point of contact</dt>
          <dd class="font-medium mt-0.5 break-words">
            <%= @job.point_of_contact? ? @job.poc_name : "—" %>
          </dd>
        </div>
        <div class="min-w-0">
          <dt class="text-ink-muted">POC phone</dt>
          <dd class="font-medium mt-0.5 break-words"<% if @job.point_of_contact? %> title="WhatsApp: <%= @job.poc_whatsapp_number %>"<% end %>>
            <%= @job.point_of_contact? ? @job.full_poc_contact_number : "—" %>
          </dd>
        </div>
        <div class="min-w-0">
          <dt class="text-ink-muted">Google Maps</dt>
          <dd class="font-medium mt-0.5 break-words">
            <% if (map_href = @job.safe_map_url) %>
              <%= content_tag :a, "Open in Google Maps",
                          href: map_href,
                          class: "no-underline break-all",
                          target: "_blank",
                          rel: "noopener noreferrer" %>
              <span class="text-ink-muted font-normal"
                    data-controller="clipboard"
                    data-clipboard-text-value="<%= map_href %>">
                (<button type="button"
                        class="bg-transparent border-0 p-0 cursor-pointer font-medium text-accent underline-offset-2 hover:underline"
                        data-action="clipboard#copy"
                        data-clipboard-target="label"
                        aria-label="Copy Google Maps link">Copy</button>)
              </span>
            <% else %>
              <span class="text-ink-muted">—</span>
            <% end %>
          </dd>
        </div>
        <div class="min-w-0">
          <dt class="text-ink-muted">Site note</dt>
          <dd class="font-medium mt-0.5 text-ink whitespace-pre-wrap break-words"><%= @job.site_note.to_s.strip.presence || "—" %></dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="card">
    <div class="card-section">
      <h2 class="section-label mb-4">Cranes</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
          <thead class="text-[--color-ink-muted] border-b border-[--color-line]">
            <tr>
              <th class="py-2 pr-4 font-medium">Type</th>
              <th class="py-2 pr-4 font-medium">LM number</th>
              <th class="py-2 font-medium">Rope Diameter (S/M/B) (mm)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[--color-line]">
            <% @job.cranes.each do |crane| %>
              <tr>
                <td class="py-2.5 pr-4 font-medium"><%= crane.crane_type_label %></td>
                <td class="py-2.5 pr-4 font-mono text-xs sm:text-sm"><%= crane.lm_number %></td>
                <td class="py-2.5"><%= crane.rope_diameter_mm %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <% if @job.notes.present? %>
    <section class="card">
      <div class="card-section">
        <h2 class="section-label mb-2">Notes</h2>
        <p class="text-sm whitespace-pre-wrap"><%= @job.notes %></p>
      </div>
    </section>
  <% end %>
</div>
