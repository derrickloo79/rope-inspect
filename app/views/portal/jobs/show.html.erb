<% content_for :title, "#{@job.reference_code} — Dashboard" %>

<div class="space-y-6">
  <div>
    <%= link_to "← Jobs", portal_jobs_path, class: "text-sm no-underline text-ink-muted hover:text-ink" %>
    <div class="mt-3 job-detail-heading">
      <% if @job.scheduled_on.present? %>
        <div class="job-cal" aria-label="<%= @job.scheduled_on.strftime("%-d %B") %><%= " #{@job.scheduled_period}" if @job.scheduled_period.present? %>">
          <div class="job-cal__badge">
            <span class="job-cal__month"><%= @job.scheduled_on.strftime("%b") %></span>
            <span class="job-cal__day"><%= @job.scheduled_on.strftime("%-d") %></span>
            <% if @job.scheduled_period.present? %>
              <span class="job-cal__period job-cal__period--<%= @job.scheduled_period.downcase %>">
                <%= @job.scheduled_period %>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>
      <div class="job-detail-heading__body min-w-0">
        <h1 class="page-title"><%= @job.site_name %></h1>
        <p class="page-lede"><%= @job.company_name %> · <%= @job.reference_code %></p>
        <div class="mt-2"><%= status_badge(@job.status) %></div>
      </div>
    </div>
  </div>

  <% if @job.scheduled_on.present? || @job.scheduled_period.present? %>
    <section class="card">
      <div class="card-section">
        <h2 class="section-label mb-4">Schedule</h2>
        <dl class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <dt class="text-sm text-[--color-ink-muted]">Date</dt>
            <dd class="text-base font-medium mt-0.5"><%= format_date(@job.scheduled_on) %></dd>
          </div>
          <div>
            <dt class="text-sm text-[--color-ink-muted]">Time</dt>
            <dd class="text-base font-medium mt-0.5"><%= @job.scheduled_period.presence || "—" %></dd>
          </div>
          <div>
            <dt class="text-sm text-[--color-ink-muted]">Assigned to</dt>
            <dd class="text-base font-medium mt-0.5"><%= @job.inspector_label.presence || "—" %></dd>
          </div>
        </dl>
      </div>
    </section>
  <% end %>

  <section class="card">
    <div class="card-section">
      <h2 class="section-label mb-4">Site &amp; requestor</h2>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="min-w-0">
          <dt class="text-sm text-ink-muted">Site</dt>
          <dd class="text-base font-medium mt-0.5 break-words"><%= @job.site_name %></dd>
        </div>
        <div class="min-w-0">
          <dt class="text-sm text-ink-muted">Company</dt>
          <dd class="text-base font-medium mt-0.5 break-words"><%= @job.company_name %></dd>
        </div>
        <div class="min-w-0">
          <dt class="text-sm text-ink-muted">Requestor</dt>
          <dd class="mt-0.5 requestor-identity">
            <span class="requestor-identity__avatar" aria-hidden="true">
              <span class="requestor-identity__initials"><%= initials_for(@job.requestor_name) %></span>
            </span>
            <span class="requestor-identity__body">
              <span class="block text-base font-medium break-words"><%= @job.requestor_name %></span>
              <% if (wa_href = whatsapp_href(@job.whatsapp_number)) %>
                <a class="requestor-identity__phone break-words inline-flex items-center gap-1 underline underline-offset-2"
                   href="<%= wa_href %>"
                   target="_blank"
                   rel="noopener noreferrer"
                   title="Message <%= @job.requestor_name %> on WhatsApp">
                  <%= @job.full_contact_number %>
                  <%= whatsapp_icon %>
                </a>
              <% else %>
                <span class="block requestor-identity__phone break-words"><%= @job.full_contact_number %></span>
              <% end %>
            </span>
          </dd>
        </div>
        <div class="min-w-0">
          <dt class="text-sm text-ink-muted">Point of contact</dt>
          <% if @job.point_of_contact? %>
            <dd class="mt-0.5 requestor-identity">
              <span class="requestor-identity__avatar" aria-hidden="true">
                <span class="requestor-identity__initials"><%= initials_for(@job.poc_name) %></span>
              </span>
              <span class="requestor-identity__body">
                <span class="block text-base font-medium break-words"><%= @job.poc_name %></span>
                <% if (poc_wa_href = whatsapp_href(@job.poc_whatsapp_number)) %>
                  <a class="requestor-identity__phone break-words inline-flex items-center gap-1 underline underline-offset-2"
                     href="<%= poc_wa_href %>"
                     target="_blank"
                     rel="noopener noreferrer"
                     title="Message <%= @job.poc_name %> on WhatsApp">
                    <%= @job.full_poc_contact_number %>
                    <%= whatsapp_icon %>
                  </a>
                <% else %>
                  <span class="block requestor-identity__phone break-words"><%= @job.full_poc_contact_number %></span>
                <% end %>
              </span>
            </dd>
          <% else %>
            <dd class="text-base font-medium mt-0.5 break-words">—</dd>
          <% end %>
        </div>
        <div class="min-w-0">
          <dt class="text-sm text-ink-muted">Google Maps</dt>
          <dd class="text-base font-medium mt-0.5 break-words">
            <% if (map_href = @job.safe_map_url) %>
              <%= content_tag :a, "Open in Google Maps",
                          href: map_href,
                          class: "no-underline break-all",
                          target: "_blank",
                          rel: "noopener noreferrer" %>
              <span class="text-ink-muted font-normal"
                    data-controller="clipboard"
                    data-clipboard-text-value="<%= map_href %>">
                (<button type="button"
                        class="bg-transparent border-0 p-0 cursor-pointer font-medium text-accent underline-offset-2 hover:underline"
                        data-action="clipboard#copy"
                        data-clipboard-target="label"
                        aria-label="Copy Google Maps link">Copy</button>)
              </span>
            <% else %>
              <span class="text-ink-muted">—</span>
            <% end %>
          </dd>
        </div>
        <div class="min-w-0">
          <dt class="text-sm text-ink-muted">Site note</dt>
          <dd class="text-base font-medium mt-0.5 text-ink whitespace-pre-wrap break-words"><%= @job.site_note.to_s.strip.presence || "—" %></dd>
        </div>
      </dl>
    </div>
  </section>

  <%= render "shared/cranes_section", cranes: @job.cranes, editable: false %>

  <% if @job.notes.present? %>
    <section class="card">
      <div class="card-section">
        <h2 class="section-label mb-2">Notes</h2>
        <p class="text-base whitespace-pre-wrap"><%= @job.notes %></p>
      </div>
    </section>
  <% end %>
</div>
