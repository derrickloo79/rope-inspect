<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Hey Tec Inspect — Rope inspections" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png" sizes="512x512">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen flex flex-col">
    <%= render "layouts/header" %>

    <% if notice.present? || alert.present? %>
      <div class="mx-auto max-w-5xl w-full px-5 pt-6 space-y-2">
        <% if notice.present? %><div class="flash-notice" role="status"><%= notice %></div><% end %>
        <% if alert.present? %><div class="flash-alert" role="alert"><%= alert %></div><% end %>
      </div>
    <% end %>

    <main class="flex-1 mx-auto w-full max-w-5xl px-5 py-10">
      <%= yield %>
    </main>

    <footer class="border-t border-line py-8">
      <div class="mx-auto max-w-5xl px-5 flex items-center justify-center gap-2 text-sm" style="color: var(--color-ink-faint);">
        <%= image_tag "inspect-logo-white-bbg.png", class: "site-logo-mark site-logo-mark--footer", alt: "" %>
        <span class="site-footer-brand">Inspect</span>
        <span> — construction wire rope inspections, kept simple.</span>
      </div>
    </footer>
  </body>
</html>
