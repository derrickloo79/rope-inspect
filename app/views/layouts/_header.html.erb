<header class="site-header"
        data-controller="menu"
        data-menu-open-class="is-menu-open"
        data-action="keydown@window->menu#keydown">
  <div class="site-header-inner">
    <%= link_to(fsp_signed_in? ? portal_root_path : root_path, class: "site-logo") do %>
      <span class="site-logo-mark">HT</span>
      <span class="site-logo-text">Hey Tec</span>
    <% end %>

    <% if user_signed_in? %>
      <%# Staff desktop primary + account nav %>
      <nav class="site-header-desktop" aria-label="Main">
        <%= link_to "Dashboard", dashboard_root_path, class: site_header_link_class(:dashboard) %>
        <%= link_to "Jobs", dashboard_inspection_requests_path, class: site_header_link_class(:jobs) %>
        <%= link_to "Planner", dashboard_planner_path, class: site_header_link_class(:planner) %>
        <%= link_to "FSPs", dashboard_fsps_path, class: site_header_link_class(:fsps) %>
        <%= link_to "Admins", dashboard_users_path, class: site_header_link_class(:admins) %>
        <%= link_to "Public form", root_path, class: site_header_link_class(:public_form) %>
      </nav>

      <div class="site-header-desktop-account">
        <%= link_to current_user.display_name,
                    edit_dashboard_profile_path,
                    class: "site-header-email no-underline #{'is-active' if nav_link_active?(:profile)}",
                    title: current_user.email %>
        <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "btn-ghost !py-1.5 !px-2 text-sm" %>
      </div>

      <button type="button"
              class="site-header-menu-btn"
              data-menu-target="button"
              data-action="menu#toggle"
              aria-expanded="false"
              aria-haspopup="dialog"
              aria-controls="site-header-menu"
              aria-label="Open menu">
        <svg data-menu-target="openIcon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 6h16" />
          <path d="M4 12h16" />
          <path d="M4 18h16" />
        </svg>
        <svg data-menu-target="closeIcon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6L6 18" />
          <path d="M6 6l12 12" />
        </svg>
      </button>
    <% elsif fsp_signed_in? %>
      <%# FSP portal nav %>
      <nav class="site-header-desktop" aria-label="Main">
        <%= link_to "My jobs", portal_root_path, class: site_header_link_class(:portal_jobs) %>
      </nav>

      <div class="site-header-desktop-account">
        <span class="site-header-email inline-flex items-center gap-2">
          <span class="fsp-color-swatch" style="background-color: <%= current_fsp.color %>;" title="<%= current_fsp.fsp_number %>"></span>
          <%= current_fsp.full_name %>
        </span>
        <%= button_to "Sign out", destroy_fsp_session_path, method: :delete, class: "btn-ghost !py-1.5 !px-2 text-sm" %>
      </div>

      <button type="button"
              class="site-header-menu-btn"
              data-menu-target="button"
              data-action="menu#toggle"
              aria-expanded="false"
              aria-haspopup="dialog"
              aria-controls="site-header-menu"
              aria-label="Open menu">
        <svg data-menu-target="openIcon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 6h16" />
          <path d="M4 12h16" />
          <path d="M4 18h16" />
        </svg>
        <svg data-menu-target="closeIcon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6L6 18" />
          <path d="M6 6l12 12" />
        </svg>
      </button>
    <% else %>
      <nav class="site-header-nav" aria-label="Account">
        <%= link_to "FSP sign in", new_fsp_session_path, class: "btn-ghost !py-1.5 !px-3 text-sm no-underline" %>
        <%= link_to "Staff sign in", new_user_session_path, class: "btn-primary !py-1.5 !px-3 text-sm no-underline" %>
      </nav>
    <% end %>
  </div>

  <% if user_signed_in? %>
    <div id="site-header-menu"
         class="site-header-modal"
         data-menu-target="panel"
         hidden>
      <div class="site-header-modal-backdrop" data-action="click->menu#close" aria-hidden="true"></div>

      <div class="site-header-modal-dialog"
           role="dialog"
           aria-modal="true"
           aria-labelledby="site-header-menu-title">
        <div class="site-header-modal-header">
          <h2 id="site-header-menu-title" class="site-header-modal-title">Menu</h2>
          <button type="button"
                  class="site-header-modal-close"
                  data-action="menu#close"
                  aria-label="Close menu">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 6L6 18" />
              <path d="M6 6l12 12" />
            </svg>
          </button>
        </div>

        <nav class="site-header-mobile-nav" aria-label="Mobile main">
          <%= link_to "Dashboard", dashboard_root_path,
                      class: site_header_link_class(:dashboard),
                      data: { action: "menu#navigate" } %>
          <%= link_to "Planner", dashboard_planner_path,
                      class: site_header_link_class(:planner),
                      data: { action: "menu#navigate" } %>
          <%= link_to "Jobs", dashboard_inspection_requests_path,
                      class: site_header_link_class(:jobs),
                      data: { action: "menu#navigate" } %>
          <%= link_to "FSPs", dashboard_fsps_path,
                      class: site_header_link_class(:fsps),
                      data: { action: "menu#navigate" } %>
          <%= link_to "Admins", dashboard_users_path,
                      class: site_header_link_class(:admins),
                      data: { action: "menu#navigate" } %>
          <%= link_to "Public form", root_path,
                      class: site_header_link_class(:public_form),
                      data: { action: "menu#navigate" } %>
          <%= link_to "My profile", edit_dashboard_profile_path,
                      class: site_header_link_class(:profile),
                      data: { action: "menu#navigate" } %>
        </nav>

        <div class="site-header-mobile-account">
          <span class="site-header-mobile-email"><%= current_user.display_name %></span>
          <%= button_to "Sign out",
                        destroy_user_session_path,
                        method: :delete,
                        class: "btn-ghost !py-1.5 !px-2 text-sm w-full justify-start",
                        form: { data: { action: "menu#navigate" } } %>
        </div>
      </div>
    </div>
  <% elsif fsp_signed_in? %>
    <div id="site-header-menu"
         class="site-header-modal"
         data-menu-target="panel"
         hidden>
      <div class="site-header-modal-backdrop" data-action="click->menu#close" aria-hidden="true"></div>

      <div class="site-header-modal-dialog"
           role="dialog"
           aria-modal="true"
           aria-labelledby="site-header-menu-title">
        <div class="site-header-modal-header">
          <h2 id="site-header-menu-title" class="site-header-modal-title">Menu</h2>
          <button type="button"
                  class="site-header-modal-close"
                  data-action="menu#close"
                  aria-label="Close menu">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 6L6 18" />
              <path d="M6 6l12 12" />
            </svg>
          </button>
        </div>

        <nav class="site-header-mobile-nav" aria-label="Mobile main">
          <%= link_to "My jobs", portal_root_path,
                      class: site_header_link_class(:portal_jobs),
                      data: { action: "menu#navigate" } %>
        </nav>

        <div class="site-header-mobile-account">
          <span class="site-header-mobile-email"><%= current_fsp.display_name %></span>
          <%= button_to "Sign out",
                        destroy_fsp_session_path,
                        method: :delete,
                        class: "btn-ghost !py-1.5 !px-2 text-sm w-full justify-start",
                        form: { data: { action: "menu#navigate" } } %>
        </div>
      </div>
    </div>
  <% end %>
</header>
