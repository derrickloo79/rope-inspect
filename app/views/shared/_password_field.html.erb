<%# locals: f, method, required, autocomplete (optional), extra (optional html options) %>
<% extra = local_assigns.fetch(:extra, {}) %>
<% autocomplete = local_assigns.fetch(:autocomplete, "new-password") %>
<div class="field-clearable" data-controller="password-visibility">
  <%= f.password_field method,
                       class: "field-input field-input--clearable",
                       required: required,
                       autocomplete: autocomplete,
                       minlength: Devise.password_length.min,
                       value: nil,
                       **extra,
                       data: { password_visibility_target: "input" } %>
  <button type="button"
          class="field-clear-btn"
          data-password-visibility-target="button"
          data-action="password-visibility#toggle"
          aria-label="Show password"
          title="Show password">
    <span data-password-visibility-target="showIcon">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" />
        <circle cx="12" cy="12" r="3" />
      </svg>
    </span>
    <span data-password-visibility-target="hideIcon" hidden>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10.733 5.127a10.06 10.06 0 0 1 11.205 6.575 1 1 0 0 1 0 .596 10.06 10.06 0 0 1-11.205 6.575" />
        <path d="M14 14.12a3 3 0 0 1-4.24-4.24" />
        <path d="m2 2 20 20" />
        <path d="M17.663 16.837A10.06 10.06 0 0 1 2.062 11.652a1 1 0 0 1 0-.696 10.06 10.06 0 0 1 5.127-4.205" />
      </svg>
    </span>
  </button>
</div>
