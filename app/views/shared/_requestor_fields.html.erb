<%# locals: f, requestor_name_label (optional) %>
<% requestor_name_label = local_assigns.fetch(:requestor_name_label, "Your name") %>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
  <div>
    <%= f.label :company_name, "Company name", class: "field-label" %>
    <%= f.text_field :company_name, class: "field-input", required: true, placeholder: "e.g. Acme Pte Ltd", autocomplete: "organization" %>
  </div>

  <div>
    <%= f.label :site_name, "Site / location", class: "field-label" %>
    <%= f.text_field :site_name, class: "field-input", required: true, placeholder: "e.g. Seletar South Link, N109, etc.." %>
  </div>

  <div>
    <%= f.label :requestor_name, requestor_name_label, class: "field-label" %>
    <%= f.text_field :requestor_name, class: "field-input", required: true, placeholder: "e.g. John Doe", autocomplete: "name" %>
  </div>

  <div>
    <%= f.label :contact_number, "Contact number", class: "field-label" %>
    <div class="grid grid-cols-4 gap-2" data-controller="country-code-select">
      <div class="col-span-1 min-w-0">
        <%= f.select :country_code,
                     country_code_select_options(f.object.country_code),
                     {},
                     country_code_select_html_options %>
      </div>
      <div class="col-span-3 min-w-0">
        <%= f.telephone_field :contact_number,
                              class: "field-input",
                              required: true,
                              placeholder: "e.g. 91234567",
                              autocomplete: "tel-national",
                              inputmode: "numeric",
                              pattern: "[0-9]+",
                              title: "Digits only",
                              data: {
                                controller: "digits-only",
                                action: "input->digits-only#filter"
                              } %>
      </div>
    </div>
    <p class="field-hint">Include country code for WhatsApp. Local number only in the right field.</p>
  </div>
</div>
