<%# locals: edit_path, delete_path, delete_confirm, show_delete (optional) %>
<% show_delete = local_assigns.fetch(:show_delete, true) %>
<div class="list-actions">
  <%= link_to edit_path, class: "list-action no-underline", aria: { label: "Edit" }, title: "Edit" do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 20h9" />
      <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
    </svg>
  <% end %>

  <% if show_delete %>
    <%= button_to delete_path,
                  method: :delete,
                  class: "list-action list-action--danger",
                  title: "Delete",
                  aria: { label: "Delete" },
                  form: { class: "inline", data: { turbo_confirm: delete_confirm } } do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 6h18" />
        <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
        <path d="M10 11v6" />
        <path d="M14 11v6" />
      </svg>
    <% end %>
  <% end %>
</div>
