<%# locals: complete, decorative (optional) %>
<% complete = local_assigns.fetch(:complete) %>
<% decorative = local_assigns.fetch(:decorative, false) %>
<% label = complete ? "Certificates on file" : "Certificates needed" %>
<span class="job-docs-icon job-docs-icon--<%= complete ? "complete" : "incomplete" %>"
      <% if decorative %>aria-hidden="true"<% else %>aria-label="<%= label %>"<% end %>>
  <% if complete %>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      <path d="M9 12.75 11.25 15 15 9.75" />
    </svg>
  <% else %>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
    </svg>
  <% end %>
</span>
