<%#
  locals:
    upcoming_by_day: Hash[Date => Array<InspectionRequest>]
    job_path: :dashboard_inspection_request_path | :portal_job_path
    fsps: optional Array<Fsp> — when present, shows the dashboard FSP filter
    fsp_filter: optional selected FSP id
%>
<% job_path = local_assigns.fetch(:job_path, :dashboard_inspection_request_path) %>
<% fsps = local_assigns[:fsps] %>
<% fsp_filter = local_assigns[:fsp_filter] %>

<section class="space-y-4" aria-labelledby="upcoming-heading">
  <h2 id="upcoming-heading" class="section-label">Upcoming · next 7 days</h2>

  <% if fsps %>
    <% selected_fsp = fsp_filter.present? ? fsps.find { |fsp| fsp.id.to_s == fsp_filter.to_s } : nil %>
    <% schedule_jobs = upcoming_by_day.sort_by { |date, _jobs| date }.flat_map { |_date, day_jobs| day_jobs }.reject(&:aborted?) %>
    <% wa_href = selected_fsp && whatsapp_href(selected_fsp.whatsapp_number, text: fsp_schedule_whatsapp_message(schedule_jobs)) %>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
      <div class="planner-week-filter">
        <%= form_with url: dashboard_root_path,
                      method: :get,
                      class: "planner-week-filter__form",
                      data: { turbo_frame: "dashboard_upcoming", turbo_action: "advance" } do %>
          <label for="dashboard-fsp-filter" class="sr-only">Filter by FSP</label>
          <%= select_tag :fsp_id,
                         options_for_select(
                           [[ "All FSPs", "" ]] + fsps.map { |fsp| [ "#{fsp.fsp_number} · #{fsp.full_name}", fsp.id ] },
                           fsp_filter
                         ),
                         id: "dashboard-fsp-filter",
                         class: "planner-week-filter__select field-select",
                         onchange: "this.form.requestSubmit()" %>
        <% end %>
      </div>
      <% if wa_href %>
        <%= link_to "WA schedule to FSP",
                    wa_href,
                    class: "btn-secondary no-underline shrink-0",
                    target: "_blank",
                    rel: "noopener noreferrer" %>
      <% else %>
        <button type="button" class="btn-secondary shrink-0" disabled>WA schedule to FSP</button>
      <% end %>
    </div>
  <% end %>

  <% if upcoming_by_day.any? %>
    <div class="space-y-6">
      <% upcoming_by_day.each do |date, jobs| %>
        <% am_jobs, rest = jobs.partition { |j| j.scheduled_period == "AM" } %>
        <% pm_jobs = rest %>
        <div class="dash-day-block">
          <h3 class="dash-day-heading">
            <% if date == Date.current %>
              Today (<%= date.strftime("%A") %>) · <%= date.strftime("%-d %b") %>
            <% elsif date == Date.current + 1 %>
              Tomorrow (<%= date.strftime("%A") %>) · <%= date.strftime("%-d %b") %>
            <% else %>
              <%= date.strftime("%A, %-d %b") %>
            <% end %>
          </h3>

          <div class="dash-period-cols mt-3">
            <% [
              [ "AM", am_jobs, "am" ],
              [ "PM", pm_jobs, "pm" ]
            ].each do |label, period_jobs, period_key| %>
              <div class="dash-period-col">
                <div class="dash-period-col__header">
                  <span class="dash-period-pill dash-period-pill--<%= period_key %>"><%= label %></span>
                </div>
                <% if period_jobs.any? %>
                  <ul class="dash-upcoming-list">
                    <% period_jobs.each do |job| %>
                      <li>
                        <%= link_to send(job_path, job),
                                    class: "dash-upcoming-item no-underline block#{ " dash-upcoming-item--aborted" if job.aborted? }",
                                    data: { turbo_frame: "_top" } do %>
                          <span class="dash-upcoming-item__heading">
                            <span class="dash-upcoming-item__title truncate"><%= job.site_name %></span>
                            <% if job.aborted? %>
                              <%= status_badge(job.status) %>
                            <% end %>
                          </span>
                          <p class="dash-upcoming-item__meta mt-0.5 truncate">
                            <%= job.company_name %>
                            · <%= pluralize(job.cranes.size, "crane") %>
                            · <%= job.reference_code %>
                          </p>
                          <% if job.aborted? && job.abort_reason.present? %>
                            <p class="dash-upcoming-item__reason"><%= job.abort_reason %></p>
                          <% end %>
                          <div class="dash-upcoming-item__fsp mt-1.5">
                            <% if job.fsp.present? %>
                              <span class="fsp-color-swatch dash-upcoming-item__swatch"
                                    style="background-color: <%= job.fsp.color %>;"
                                    title="<%= job.fsp.display_name %>"></span>
                              <span class="dash-upcoming-item__fsp-number"><%= job.fsp.fsp_number %></span>
                            <% else %>
                              <span class="dash-upcoming-item__unassigned">Unassigned</span>
                            <% end %>
                          </div>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                <% else %>
                  <p class="dash-period-col__empty">No jobs</p>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12 text-ink-muted">
      <p class="font-medium text-ink">No inspections scheduled in the next 7 days.</p>
    </div>
  <% end %>
</section>
