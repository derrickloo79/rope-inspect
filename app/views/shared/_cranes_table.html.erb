<%#
  Shared cranes table (job detail / portal / public status).
  locals:
    cranes: (required) collection of Crane
    title:  (optional) section heading, default "Cranes"
%>
<% title = local_assigns.fetch(:title, "Cranes") %>

<section class="card">
  <div class="card-section">
    <h2 class="section-label mb-4"><%= title %></h2>
    <% if cranes.any? %>
      <div class="overflow-x-auto">
        <table class="cranes-table">
          <thead>
            <tr>
              <th scope="col">Type</th>
              <th scope="col">LM number</th>
              <th scope="col">Rope diameter (S/M/B) (mm)</th>
            </tr>
          </thead>
          <tbody>
            <% cranes.each do |crane| %>
              <tr>
                <td class="cranes-table__type"><%= crane.crane_type_label %></td>
                <td class="cranes-table__lm"><%= crane.lm_number %></td>
                <td class="cranes-table__rope"><%= crane.rope_diameter_mm %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="cranes-table__empty">No cranes listed for this job.</p>
    <% end %>
  </div>
</section>
